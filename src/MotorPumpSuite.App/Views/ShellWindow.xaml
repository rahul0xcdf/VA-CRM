<Window x:Class="MotorPumpSuite.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MotorPumpSuite.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="{Binding Title}"
        Height="560" Width="920"
        WindowStartupLocation="CenterScreen"
        Background="#FFF4F6F9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,18">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF101B3D" Offset="0.0" />
                    <GradientStop Color="#FF0E4A52" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel>
                <TextBlock Text="{Binding Title}"
                           FontSize="24"
                           FontWeight="Light"
                           Foreground="#FFF6F9FC" />
                <TextBlock Text="{Binding Tagline}"
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="#99E4EEF6" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="32,28" VerticalAlignment="Top">
            <TextBlock Text="Phase 0 — Foundations"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#FF1B2A4A" />

            <TextBlock Margin="0,6,0,20"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="#FF5A6B85"
                       Text="The shell exists to prove the composition root: configuration, logging, the schema migration, and both database paths. Ledgers, vouchers and stock arrive in Phase 1." />

            <Border Background="White"
                    CornerRadius="10"
                    Padding="20"
                    BorderBrush="#FFE1E7EF"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Companies (repository / EF Core)"
                               FontSize="11"
                               Foreground="#FF7A8AA3" />
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="{Binding CompanyCountViaRepository}"
                               FontSize="32"
                               FontWeight="Light"
                               Foreground="#FF12314F" />

                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="Companies (reporting / Dapper)"
                               FontSize="11"
                               Foreground="#FF7A8AA3" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding CompanyCountViaDapper}"
                               FontSize="32"
                               FontWeight="Light"
                               Foreground="#FF12314F" />
                </Grid>
            </Border>

            <!-- AsyncRelayCommand reports CanExecute = false while it is running, so the button
                 disables itself during a refresh without a converter. -->
            <Button Content="Refresh"
                    Margin="0,20,0,0"
                    Padding="18,8"
                    HorizontalAlignment="Left"
                    Command="{Binding RefreshCommand}" />
        </StackPanel>

        <Border Grid.Row="2" Background="#FFEDF1F6" Padding="24,10">
            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#FF5A6B85" />
        </Border>
    </Grid>
</Window>
