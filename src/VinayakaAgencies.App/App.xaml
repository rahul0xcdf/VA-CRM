<Application x:Class="VinayakaAgencies.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- No StartupUri: the generic host owns the composition root and decides which window opens,
         so that no view is constructed before configuration, logging and the schema are ready. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Presentation/Themes/Colors.xaml" />
                <ResourceDictionary Source="Presentation/Themes/Typography.xaml" />
                <ResourceDictionary Source="Presentation/Themes/Controls.xaml" />
                <ResourceDictionary Source="Presentation/Themes/Shell.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
