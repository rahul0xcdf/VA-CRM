<UserControl x:Class="VinayakaAgencies.App.Views.AccountGroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:nav="clr-namespace:VinayakaAgencies.App.Navigation"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="860">

    <UserControl.Resources>
        <nav:GroupIndentConverter x:Key="IndentConverter" />
    </UserControl.Resources>

    <!-- Master-list page (ADR-0006). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Account groups" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="system groups are shown but locked (spec §2)"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <DataGrid Style="{StaticResource PageGrid}"
                      ItemsSource="{Binding Groups}"
                      SelectedItem="{Binding SelectedGroup}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Group (tree order)" Width="3*"
                                        Binding="{Binding Converter={StaticResource IndentConverter}}" />
                    <DataGridTextColumn Header="Nature" Binding="{Binding Nature}" Width="130" />
                    <DataGridCheckBoxColumn Header="Gross profit" Binding="{Binding AffectsGrossProfit}" Width="90" />
                    <DataGridCheckBoxColumn Header="Primary" Binding="{Binding IsPrimary}" Width="70" />
                    <DataGridCheckBoxColumn Header="System" Binding="{Binding IsSystem}" Width="70" />
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Style="{StaticResource EmptyStateText}"
                       Text="No account groups yet."
                       Visibility="{Binding Groups.Count, Converter={StaticResource ZeroToVisibility}}" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource EntryPanelStyle}">
            <StackPanel>
                <TextBlock Text="CREATE / RENAME" Style="{StaticResource EntryHeadingText}" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="210" Style="{StaticResource FieldBox}"
                             Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Under" Style="{StaticResource FieldLabel}" />
                    <ComboBox Width="220" Style="{StaticResource FieldCombo}"
                              ItemsSource="{Binding ParentChoices}"
                              SelectedItem="{Binding NewParentGroup}" DisplayMemberPath="Name" />

                    <TextBlock Text="Sort" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="56" MinWidth="0" Style="{StaticResource FieldBox}"
                             Text="{Binding NewSortOrder}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                    <Button Content="Add group" Style="{StaticResource BandButton}"
                            Command="{Binding AddGroupCommand}" />
                    <Button Content="Rename selected" Style="{StaticResource BandButton}"
                            Command="{Binding RenameSelectedCommand}" />
                    <Button Content="Refresh" Style="{StaticResource BandButton}"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource PageStatusStyle}">
            <TextBlock Text="{Binding Status}" Style="{StaticResource PageStatusText}" />
        </Border>
    </Grid>
</UserControl>
