<UserControl x:Class="VinayakaAgencies.App.Views.AccountGroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:nav="clr-namespace:VinayakaAgencies.App.Navigation"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="860">

    <UserControl.Resources>
        <nav:GroupIndentConverter x:Key="IndentConverter" />
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Account groups — system groups are shown but locked (spec §2)"
                   FontSize="16" FontWeight="SemiBold" Foreground="#FF1B2A4A" />

        <DataGrid Grid.Row="1" Margin="0,12,0,12"
                  ItemsSource="{Binding Groups}"
                  SelectedItem="{Binding SelectedGroup}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Group (tree order)" Binding="{Binding Converter={StaticResource IndentConverter}}" Width="3*" />
                <DataGridTextColumn Header="Nature" Binding="{Binding Nature}" Width="SizeToHeader" />
                <DataGridCheckBoxColumn Header="Gross profit" Binding="{Binding AffectsGrossProfit}" Width="SizeToHeader" />
                <DataGridCheckBoxColumn Header="Primary" Binding="{Binding IsPrimary}" Width="SizeToHeader" />
                <DataGridCheckBoxColumn Header="System" Binding="{Binding IsSystem}" Width="SizeToHeader" />
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="SizeToHeader" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="#FFF7F9FC" Padding="12" CornerRadius="6"
                BorderBrush="#FFE1E7EF" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="New / renamed group:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FF5A6B85" />
                <TextBox Width="200" Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                <TextBlock Text="Under:" VerticalAlignment="Center" Margin="16,0,8,0" Foreground="#FF5A6B85" />
                <ComboBox Width="220" ItemsSource="{Binding ParentChoices}"
                          SelectedItem="{Binding NewParentGroup}"
                          DisplayMemberPath="Name" VerticalAlignment="Center" />
                <TextBlock Text="Sort:" VerticalAlignment="Center" Margin="16,0,8,0" Foreground="#FF5A6B85" />
                <TextBox Width="50" Text="{Binding NewSortOrder}" VerticalAlignment="Center" />
                <Button Content="Add group" Margin="16,0,0,0" Padding="14,5"
                        Command="{Binding AddGroupCommand}" />
                <Button Content="Rename selected" Margin="8,0,0,0" Padding="14,5"
                        Command="{Binding RenameSelectedCommand}" />
                <Button Content="Refresh" Margin="8,0,0,0" Padding="14,5"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Margin="4,8,0,0" Text="{Binding Status}" Foreground="#FF5A6B85" />
    </Grid>
</UserControl>