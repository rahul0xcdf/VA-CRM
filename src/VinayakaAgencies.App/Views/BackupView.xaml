<UserControl x:Class="VinayakaAgencies.App.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="900">

    <!-- Report-shaped page (ADR-0006): header, action band, list, notices, status line. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Backup &amp; Restore" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="verified archives of the books, the templates and your settings"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Refresh" Style="{StaticResource BandButton}"
                        Command="{Binding LoadCommand}" />

                <Button Content="Back up now" Style="{StaticResource BandButton}"
                        Command="{Binding BackupNowCommand}" />

                <Button Content="Verify" Style="{StaticResource BandButton}"
                        Command="{Binding VerifyCommand}" />

                <!--
                  Restore arms rather than acts; the confirm button appears beside it only once
                  armed, so the destructive press is never the one already under the finger.
                -->
                <Button Content="Restore…" Style="{StaticResource BandButton}"
                        Command="{Binding RestoreCommand}" />

                <Button Content="Confirm restore" Style="{StaticResource BandButton}"
                        Command="{Binding ConfirmRestoreCommand}"
                        Visibility="{Binding IsRestoreArmed, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="Cancel" Style="{StaticResource BandButton}"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding IsRestoreArmed, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="Collect diagnostics" Style="{StaticResource BandButton}"
                        Command="{Binding CollectDiagnosticsCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <DataGrid Style="{StaticResource PageGrid}"
                      ItemsSource="{Binding Archives}"
                      SelectedItem="{Binding SelectedArchive}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Backup" Binding="{Binding FileName}" Width="2.2*" />
                    <DataGridTextColumn Header="Taken (UTC)"
                                        Binding="{Binding CreatedAtUtc, StringFormat=yyyy-MM-dd HH:mm}"
                                        Width="*" />
                    <DataGridTextColumn Header="Why" Binding="{Binding Manifest.Reason}" Width="1.4*" />
                    <DataGridTextColumn Header="By" Binding="{Binding Manifest.CreatedBy}" Width="*" />
                    <DataGridTextColumn Header="Size"
                                        Binding="{Binding SizeBytes, StringFormat={}{0:N0} bytes}"
                                        ElementStyle="{StaticResource NumericCell}"
                                        HeaderStyle="{StaticResource NumericColumnHeader}"
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Style="{StaticResource EmptyStateText}"
                       Text="No backups on this machine yet. Press Back up now — it takes a few seconds and verifies itself afterwards."
                       Visibility="{Binding Archives.Count, Converter={StaticResource ZeroToVisibility}}" />
        </Grid>

        <!-- Detail of the last action: destination paths, verification problems, the safety copy. -->
        <Border Grid.Row="3" Style="{StaticResource SectionBorderStyle}"
                Visibility="{Binding VerificationDetail, Converter={StaticResource EmptyStringToVisibility}}">
            <TextBlock Text="{Binding VerificationDetail}" TextWrapping="Wrap"
                       Style="{StaticResource SettingsCaptionText}" />
        </Border>

        <StackPanel Grid.Row="4">
            <!--
              The two things phase-10 section 4a D2 and D5 say must not be left to word of mouth:
              whether an off-machine copy exists, and that the database is not encrypted.
            -->
            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Where your books and backups are"
                               Style="{StaticResource SectionHeaderText}" />
                    <TextBlock Text="{Binding DataDirectory}" TextWrapping="Wrap"
                               Style="{StaticResource SettingsCaptionText}" />
                    <TextBlock Text="{Binding BackupDirectory}" TextWrapping="Wrap"
                               Style="{StaticResource SettingsCaptionText}" />

                    <TextBlock Text="{Binding RetentionNotice}" TextWrapping="Wrap"
                               Margin="0,8,0,0" Style="{StaticResource SettingsCaptionText}" />

                    <TextBlock Text="{Binding SecondDestinationStatus}" TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource WarningBrush}"
                               Style="{StaticResource SettingsCaptionText}" />

                    <TextBlock Text="{Binding DataAtRestNotice}" TextWrapping="Wrap"
                               Margin="0,8,0,0" Style="{StaticResource SettingsCaptionText}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PageStatusStyle}">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                           Style="{StaticResource PageStatusText}" />
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
