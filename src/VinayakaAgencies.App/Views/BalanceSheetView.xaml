<UserControl x:Class="VinayakaAgencies.App.Views.BalanceSheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="900">

    <!-- Two-column report page (ADR-0006). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Balance sheet" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="the derived Profit &amp; Loss A/c carries the accumulated result"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="As on" Style="{StaticResource FieldLabel}" />
                <DatePicker Width="140" Margin="0,0,16,0" VerticalAlignment="Center"
                            SelectedDate="{Binding AsOnDate}" />
                <Button Content="Load" Style="{StaticResource BandButton}" Command="{Binding LoadCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" Style="{StaticResource PageGrid}" ItemsSource="{Binding Assets}"
                      SelectedItem="{Binding SelectedAsset}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Assets" Binding="{Binding LedgerName}" Width="2.2*" />
                    <DataGridTextColumn Header="Group" Binding="{Binding AccountGroupName}" Width="1.4*" />
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="130"
                                        ElementStyle="{StaticResource NumericCell}"
                                        HeaderStyle="{StaticResource NumericColumnHeader}" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Width="1" Background="{StaticResource ControlBorderBrush}" />

            <DataGrid Grid.Column="2" Style="{StaticResource PageGrid}" ItemsSource="{Binding Liabilities}"
                      SelectedItem="{Binding SelectedLiability}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Liabilities &amp; equity" Binding="{Binding LedgerName}" Width="2.2*" />
                    <DataGridTextColumn Header="Group" Binding="{Binding AccountGroupName}" Width="1.4*" />
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="130"
                                        ElementStyle="{StaticResource NumericCell}"
                                        HeaderStyle="{StaticResource NumericColumnHeader}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource TotalsBandStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Total assets" Style="{StaticResource TotalsLabelText}" />
                <TextBlock Text="{Binding TotalAssets, StringFormat=N2}" Style="{StaticResource TotalsValueText}" />
                <TextBlock Text="Total liabilities" Style="{StaticResource TotalsLabelText}" />
                <TextBlock Text="{Binding TotalLiabilities, StringFormat=N2}" Style="{StaticResource TotalsValueText}" />
            </StackPanel>
        </Border>

        <!-- Ctrl+Enter fills this; it stays collapsed until then. -->
        <Border Grid.Row="4" Style="{StaticResource DrillDownBandStyle}"
                Visibility="{Binding DrillDownRows.Count, Converter={StaticResource NonZeroToVisibility}}">
            <StackPanel>
                <TextBlock Text="LEDGER STATEMENT THIS FINANCIAL YEAR" Style="{StaticResource DrillDownHeadingText}" />
                <DataGrid Style="{StaticResource PageGrid}" ItemsSource="{Binding DrillDownRows}"
                          MaxHeight="180" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding VoucherDate, StringFormat=dd-MMM-yy}" Width="100" />
                        <DataGridTextColumn Header="Number" Binding="{Binding VoucherNumber}" Width="130" />
                        <DataGridTextColumn Header="Type" Binding="{Binding VoucherTypeName}" Width="130" />
                        <DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat=N2}" Width="120"
                                            ElementStyle="{StaticResource NumericCell}"
                                            HeaderStyle="{StaticResource NumericColumnHeader}" />
                        <DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat=N2}" Width="120"
                                            ElementStyle="{StaticResource NumericCell}"
                                            HeaderStyle="{StaticResource NumericColumnHeader}" />
                        <DataGridTextColumn Header="Narration" Binding="{Binding Narration}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource PageStatusStyle}">
            <TextBlock Text="{Binding Status}" Style="{StaticResource PageStatusText}" />
        </Border>
    </Grid>
</UserControl>
