<UserControl x:Class="VinayakaAgencies.App.Views.BankReconciliationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="920">

    <!-- Report page with an action band (ADR-0006). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Bank reconciliation" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="manual marking only in this phase (spec 12)"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Load bank ledgers" Style="{StaticResource BandButton}"
                        Command="{Binding LoadListsCommand}" />

                <TextBlock Text="Ledger" Style="{StaticResource FieldLabel}" />
                <ComboBox Width="220" Style="{StaticResource FieldCombo}"
                          ItemsSource="{Binding BankLedgers}"
                          SelectedItem="{Binding SelectedLedger}" DisplayMemberPath="Name" />

                <TextBlock Text="From" Style="{StaticResource FieldLabel}" />
                <DatePicker Width="130" Margin="0,0,12,0" VerticalAlignment="Center"
                            SelectedDate="{Binding FromDate}" />

                <TextBlock Text="To" Style="{StaticResource FieldLabel}" />
                <DatePicker Width="130" Margin="0,0,16,0" VerticalAlignment="Center"
                            SelectedDate="{Binding ToDate}" />

                <Button Content="Statement" Style="{StaticResource BandButton}"
                        Command="{Binding LoadStatementCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <DataGrid Style="{StaticResource PageGrid}"
                      ItemsSource="{Binding Lines}"
                      SelectedItem="{Binding SelectedLine}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding VoucherDate, StringFormat=dd-MMM-yy}" Width="100" />
                    <DataGridTextColumn Header="Voucher" Binding="{Binding VoucherNumber}" Width="130" />
                    <DataGridTextColumn Header="Type" Binding="{Binding VoucherTypeName}" Width="130" />
                    <DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat=N2}" Width="120"
                                        ElementStyle="{StaticResource NumericCell}"
                                        HeaderStyle="{StaticResource NumericColumnHeader}" />
                    <DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat=N2}" Width="120"
                                        ElementStyle="{StaticResource NumericCell}"
                                        HeaderStyle="{StaticResource NumericColumnHeader}" />
                    <DataGridTextColumn Header="Narration" Binding="{Binding Narration}" Width="*" />
                    <DataGridCheckBoxColumn Header="Cleared" Binding="{Binding IsCleared}" Width="66" />
                    <DataGridTextColumn Header="Bank date" Binding="{Binding ClearedOnBank, StringFormat=dd-MMM-yy}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Style="{StaticResource EmptyStateText}"
                       Text="Nothing to reconcile. Pick a bank ledger and a period, then press Statement."
                       Visibility="{Binding Lines.Count, Converter={StaticResource ZeroToVisibility}}" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource EntryPanelStyle}">
            <StackPanel>
                <TextBlock Text="MARK THE SELECTED LINE" Style="{StaticResource EntryHeadingText}" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Cleared on" Style="{StaticResource FieldLabel}" />
                    <DatePicker Width="140" Margin="0,0,16,0" VerticalAlignment="Center"
                                SelectedDate="{Binding BankDate}" />
                    <Button Content="Mark cleared" Style="{StaticResource BandButton}"
                            Command="{Binding MarkClearedCommand}" />
                    <Button Content="Withdraw mark" Style="{StaticResource BandButton}"
                            Command="{Binding UnmarkClearedCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource PageStatusStyle}">
            <TextBlock Text="{Binding Status}" Style="{StaticResource PageStatusText}" />
        </Border>
    </Grid>
</UserControl>
