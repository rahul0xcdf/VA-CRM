<UserControl x:Class="VinayakaAgencies.App.Views.CategoryPriceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <!-- Master-list page (ADR-0006). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Category price lists" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="what each category pays, per item"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Category" Style="{StaticResource FieldLabel}" />
                <ComboBox Width="220" Style="{StaticResource FieldCombo}"
                          ItemsSource="{Binding CategoryChoices}"
                          SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" />
                <Button Content="Refresh" Style="{StaticResource BandButton}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <DataGrid Style="{StaticResource PageGrid}" IsReadOnly="False"
                      ItemsSource="{Binding PriceLines}"
                      SelectedItem="{Binding SelectedLine}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" IsReadOnly="True" Width="*" />
                    <DataGridTemplateColumn Header="Basis" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Basis}" VerticalAlignment="Center" Margin="4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox SelectedItem="{Binding Basis}"
                                          ItemsSource="{Binding DataContext.BasisChoices,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Fixed ₹ / percent" Binding="{Binding ValueText}" Width="170"
                                        ElementStyle="{StaticResource NumericCell}"
                                        HeaderStyle="{StaticResource NumericColumnHeader}" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Style="{StaticResource EmptyStateText}"
                       Text="No price lines for this category. Add one below, or leave it empty to bill at the item's own rate."
                       Visibility="{Binding PriceLines.Count, Converter={StaticResource ZeroToVisibility}}" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource EntryPanelStyle}">
            <StackPanel>
                <TextBlock Text="ADD A PRICE LINE" Style="{StaticResource EntryHeadingText}" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Item" Style="{StaticResource FieldLabel}" />
                    <ComboBox Width="270" Style="{StaticResource FieldCombo}"
                              ItemsSource="{Binding ItemChoices}"
                              SelectedItem="{Binding NewItem}" DisplayMemberPath="Name" />

                    <TextBlock Text="Basis" Style="{StaticResource FieldLabel}" />
                    <ComboBox Width="190" MinWidth="0" Style="{StaticResource FieldCombo}"
                              ItemsSource="{Binding BasisChoices}"
                              SelectedItem="{Binding NewBasis}" />

                    <TextBlock Text="Value" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="120" MinWidth="0" Style="{StaticResource FieldBox}"
                             ToolTip="Rupees on a fixed price, otherwise a percent."
                             Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Content="Add line" Style="{StaticResource BandButton}"
                            Command="{Binding AddLineCommand}" />
                    <Button Content="Remove" Style="{StaticResource BandButton}"
                            Command="{Binding RemoveSelectedCommand}" />
                    <Button Content="Save prices" Style="{StaticResource BandButton}"
                            Command="{Binding SavePricesCommand}" />
                </StackPanel>

                <TextBlock Margin="0,7,0,0" Style="{StaticResource SettingsCaptionText}"
                           Text="Fixed price bills that rupee amount. Margin on cost adds the percent to the item's current cost. Margin on sale price discounts the percent off the item's default sale price, which is set on the item master." />
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource PageStatusStyle}">
            <TextBlock Text="{Binding Status}" Style="{StaticResource PageStatusText}" />
        </Border>
    </Grid>
</UserControl>
