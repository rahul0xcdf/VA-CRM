<UserControl x:Class="VinayakaAgencies.App.Views.CustomerCategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Customer categories — each customer prices from exactly one category"
                   Style="{StaticResource ScreenTitleText}" />

        <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,10,0,8">
            <CheckBox Content="Include inactive" VerticalAlignment="Center"
                      IsChecked="{Binding IncludeInactive}" />
            <Button Content="Refresh" Margin="16,0,0,0" Padding="14,5"
                    Command="{Binding RefreshCommand}" />
        </DockPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Categories}"
                  SelectedItem="{Binding SelectedCategory}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*" />
                <DataGridTextColumn Header="Customers" Binding="{Binding CustomerCount}" Width="SizeToHeader" />
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="SizeToHeader" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" Padding="12" Margin="0,12,0,0" CornerRadius="6"
                BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Name:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Width="200" Margin="6,0,12,0"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Description:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Width="380" Margin="6,0,12,0" Text="{Binding EditDescription}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="New" Padding="14,5" Command="{Binding NewCommand}" />
                    <Button Content="Save category" Margin="8,0,0,0" Padding="14,5"
                            Command="{Binding SaveCommand}" />
                    <Button Content="Deactivate" Margin="8,0,0,0" Padding="14,5"
                            Command="{Binding DeactivateSelectedCommand}" />
                    <Button Content="Reactivate" Margin="8,0,0,0" Padding="14,5"
                            Command="{Binding ActivateSelectedCommand}" />
                    <Button Content="Delete (only if never used)" Margin="8,0,0,0" Padding="14,5"
                            Command="{Binding DeleteSelectedCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="4" LastChildFill="False">
            <TextBlock DockPanel.Dock="Right" Margin="0,12,0,0"
                       Text="{Binding Status}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</UserControl>
