<UserControl x:Class="VinayakaAgencies.App.Views.CustomerMasterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:VinayakaAgencies.App.Views"
             mc:Ignorable="d"
             d:DesignHeight="860" d:DesignWidth="1280">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Customers — who buys, what they pay, and the terms they buy on"
                   Style="{StaticResource ScreenTitleText}" />

        <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,10,0,8">
            <TextBlock Text="Search:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBox Width="220" Margin="6,0,16,0"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox Content="Include inactive" VerticalAlignment="Center"
                      IsChecked="{Binding IncludeInactive}" />
            <Button Content="Refresh / search" Margin="16,0,0,0" Padding="14,5"
                    Command="{Binding RefreshCommand}" />
        </DockPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Customers}"
                  SelectedItem="{Binding SelectedCustomer}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Category" Binding="{Binding CustomerCategoryName}" Width="*" />
                <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="SizeToCells" />
                <DataGridTextColumn Header="GSTIN" Binding="{Binding Gstin}" Width="SizeToCells" />
                <DataGridTextColumn Header="Place of supply" Binding="{Binding PlaceOfSupplyStateCode}" Width="SizeToHeader" />
                <DataGridTextColumn Header="Credit limit" Binding="{Binding CreditLimit}" Width="SizeToHeader" />
                <DataGridTextColumn Header="Credit days" Binding="{Binding CreditPeriodDays}" Width="SizeToHeader" />
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="SizeToHeader" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" Padding="12" Margin="0,12,0,0" CornerRadius="6"
                BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Name:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Width="180" Margin="6,0,12,0"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Category:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <ComboBox Width="140" Margin="6,0,12,0"
                              ItemsSource="{Binding CategoryChoices}"
                              SelectedValue="{Binding EditCategoryId}"
                              SelectedValuePath="Id" DisplayMemberPath="Name" />
                    <TextBlock Text="Contact:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Width="120" Margin="6,0,12,0" Text="{Binding EditContactPerson}" />
                    <TextBlock Text="Phone:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Width="110" Margin="6,0,12,0" Text="{Binding EditPhoneNumber}" />
                    <TextBlock Text="Email:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Width="140" Margin="6,0,0,0" Text="{Binding EditEmail}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="GSTIN:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Width="150" Margin="6,0,12,0" Text="{Binding EditGstin}" />
                    <TextBlock Text="Place of supply (state code):" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Width="40" Margin="6,0,16,0" Text="{Binding EditPlaceOfSupply}" />
                    <TextBlock Text="Credit limit (₹, 0 = none):" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Width="80" Margin="6,0,12,0" Text="{Binding EditCreditLimit}" />
                    <TextBlock Text="Credit period (days):" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Width="50" Margin="6,0,0,0" Text="{Binding EditCreditPeriodDays}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Billing address:" VerticalAlignment="Top" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Width="300" Height="44" Margin="6,0,12,0" TextWrapping="Wrap"
                             AcceptsReturn="True" Text="{Binding EditBillingAddress}" />
                    <TextBlock Text="Shipping address:" VerticalAlignment="Top" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Width="300" Height="44" Margin="6,0,0,0" TextWrapping="Wrap"
                             AcceptsReturn="True" Text="{Binding EditShippingAddress}" />
                </StackPanel>

                <!-- Per-customer special prices: win over the category price list (spec §4a). -->
                <TextBlock Text="Special prices for this customer (win over the category list)"
                           Margin="0,12,0,4" Style="{StaticResource SectionHeaderText}" />
                <DataGrid Height="110"
                          ItemsSource="{Binding SpecialPrices}"
                          SelectedItem="{Binding SelectedSpecialPrice}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" IsReadOnly="True" Width="*" />
                        <DataGridTemplateColumn Header="Basis" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Basis}" VerticalAlignment="Center" Margin="4,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedItem="{Binding Basis}"
                                              ItemsSource="{Binding DataContext.BasisChoices, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Fixed ₹ / percent" Binding="{Binding ValueText}" Width="150" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ComboBox Width="240"
                              ItemsSource="{Binding ItemChoices}"
                              SelectedItem="{Binding NewSpecialItem}"
                              DisplayMemberPath="Name" />
                    <ComboBox Width="160" Margin="6,0,6,0"
                              ItemsSource="{Binding BasisChoices}"
                              SelectedItem="{Binding NewSpecialBasis}" />
                    <TextBox Width="100"
                             ToolTip="Rupees on a fixed price, otherwise a percent"
                             Text="{Binding NewSpecialValue, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Add special price" Margin="6,0,0,0" Padding="14,5"
                            Command="{Binding AddSpecialPriceCommand}" />
                    <Button Content="Remove selected" Margin="8,0,0,0" Padding="14,5"
                            Command="{Binding RemoveSpecialPriceCommand}" />
                    <Button Content="Save special prices" Margin="8,0,0,0" Padding="14,5"
                            Command="{Binding SaveSpecialPricesCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="New" Padding="14,5" Command="{Binding NewCommand}" />
                    <Button Content="Save customer" Margin="8,0,0,0" Padding="14,5"
                            Command="{Binding SaveCommand}" />
                    <Button Content="Deactivate" Margin="8,0,0,0" Padding="14,5"
                            Command="{Binding DeactivateSelectedCommand}" />
                    <Button Content="Reactivate" Margin="8,0,0,0" Padding="14,5"
                            Command="{Binding ActivateSelectedCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="4" LastChildFill="False">
            <TextBlock DockPanel.Dock="Right" Margin="0,12,0,0"
                       Text="{Binding Status}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</UserControl>
