<UserControl x:Class="VinayakaAgencies.App.Views.CustomerStatementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="780" d:DesignWidth="1150">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Customer statement — the account of one customer, straight from the books"
                   FontSize="16" FontWeight="SemiBold" Foreground="#FF1B2A4A" />

        <Border Grid.Row="1" Background="#FFF7F9FC" Padding="12" Margin="0,10,0,8" CornerRadius="6"
                BorderBrush="#FFE1E7EF" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Customer:" VerticalAlignment="Center" Foreground="#FF5A6B85" />
                    <ComboBox Width="260" Margin="6,0,16,0"
                              ItemsSource="{Binding CustomerChoices}"
                              SelectedItem="{Binding SelectedCustomer}"
                              DisplayMemberPath="Name" />
                    <TextBlock Text="From:" VerticalAlignment="Center" Foreground="#FF5A6B85" />
                    <DatePicker Width="120" Margin="6,0,12,0" SelectedDate="{Binding FromDate}" />
                    <TextBlock Text="To:" VerticalAlignment="Center" Foreground="#FF5A6B85" />
                    <DatePicker Width="120" Margin="6,0,16,0" SelectedDate="{Binding ToDate}" />
                    <Button Content="Load statement" Padding="14,5" Command="{Binding LoadCommand}" />
                    <Button Content="Refresh customers" Margin="8,0,0,0" Padding="14,5"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="Statement" FontWeight="SemiBold" Foreground="#FF1B2A4A" />

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Statement.Rows}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  CanUserAddRows="False" Margin="0,4,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="95" />
                <DataGridTextColumn Header="Voucher" Binding="{Binding VoucherNumber}" Width="130" />
                <DataGridTextColumn Header="Type" Binding="{Binding VoucherTypeName}" Width="150" />
                <DataGridTextColumn Header="Debit (billed)" Binding="{Binding Debit}" Width="110" />
                <DataGridTextColumn Header="Credit (received)" Binding="{Binding Credit}" Width="120" />
                <DataGridTextColumn Header="Running balance" Binding="{Binding RunningBalance}" Width="130" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3">
            <TextBlock Text="Open bills — receipts pay the oldest bill first"
                       FontWeight="SemiBold" Foreground="#FF1B2A4A" Margin="0,10,0,4" />
            <DataGrid Height="170"
                      ItemsSource="{Binding OpenBills}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="140" />
                    <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate}" Width="100" />
                    <DataGridTextColumn Header="Billed" Binding="{Binding BilledAmount}" Width="110" />
                    <DataGridTextColumn Header="Paid so far" Binding="{Binding PaidAmount}" Width="110" />
                    <DataGridTextColumn Header="Outstanding" Binding="{Binding OutstandingAmount}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Print / preview" Padding="14,5" Command="{Binding PrintCommand}" />
                <Button Content="Export CSV" Margin="8,0,0,0" Padding="14,5"
                        Command="{Binding ExportCsvCommand}" />
            </StackPanel>
        </StackPanel>

        <DockPanel Grid.Row="4" LastChildFill="False">
            <TextBlock DockPanel.Dock="Right" Margin="0,12,0,0"
                       Text="{Binding Status}" Foreground="#FF5A6B85" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</UserControl>
