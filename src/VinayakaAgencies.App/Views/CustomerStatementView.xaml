<UserControl x:Class="VinayakaAgencies.App.Views.CustomerStatementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="780" d:DesignWidth="1150">

    <!--
        Report page with a second table (ADR-0006).

        The previous version put the "Statement" caption and the statement grid both in Grid.Row 2,
        so the caption was painted underneath the grid and never seen. Each band now owns a row.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Customer statement" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="the account of one customer, straight from the books"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Customer" Style="{StaticResource FieldLabel}" />
                <ComboBox Width="270" Style="{StaticResource FieldCombo}"
                          ItemsSource="{Binding CustomerChoices}"
                          SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name" />

                <TextBlock Text="From" Style="{StaticResource FieldLabel}" />
                <DatePicker Width="130" Margin="0,0,12,0" VerticalAlignment="Center"
                            SelectedDate="{Binding FromDate}" />

                <TextBlock Text="To" Style="{StaticResource FieldLabel}" />
                <DatePicker Width="130" Margin="0,0,16,0" VerticalAlignment="Center"
                            SelectedDate="{Binding ToDate}" />

                <Button Content="Load statement" Style="{StaticResource BandButton}"
                        Command="{Binding LoadCommand}" />
                <Button Content="Refresh customers" Style="{StaticResource BandButton}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource TotalsBandStyle}">
            <TextBlock Text="STATEMENT" Style="{StaticResource EntryHeadingText}" Margin="0" />
        </Border>

        <DataGrid Grid.Row="3" Style="{StaticResource PageGrid}" ItemsSource="{Binding Statement.Rows}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="100" />
                <DataGridTextColumn Header="Voucher" Binding="{Binding VoucherNumber}" Width="140" />
                <DataGridTextColumn Header="Type" Binding="{Binding VoucherTypeName}" Width="160" />
                <DataGridTextColumn Header="Billed" Binding="{Binding Debit}" Width="120"
                                    ElementStyle="{StaticResource NumericCell}"
                                    HeaderStyle="{StaticResource NumericColumnHeader}" />
                <DataGridTextColumn Header="Received" Binding="{Binding Credit}" Width="120"
                                    ElementStyle="{StaticResource NumericCell}"
                                    HeaderStyle="{StaticResource NumericColumnHeader}" />
                <DataGridTextColumn Header="Running balance" Binding="{Binding RunningBalance}" Width="*"
                                    ElementStyle="{StaticResource NumericCell}"
                                    HeaderStyle="{StaticResource NumericColumnHeader}" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="4" Style="{StaticResource TotalsBandStyle}">
            <TextBlock Text="OPEN BILLS — RECEIPTS PAY THE OLDEST BILL FIRST"
                       Style="{StaticResource EntryHeadingText}" Margin="0" />
        </Border>

        <DataGrid Grid.Row="5" Style="{StaticResource PageGrid}" ItemsSource="{Binding OpenBills}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="150" />
                <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate}" Width="110" />
                <DataGridTextColumn Header="Billed" Binding="{Binding BilledAmount}" Width="120"
                                    ElementStyle="{StaticResource NumericCell}"
                                    HeaderStyle="{StaticResource NumericColumnHeader}" />
                <DataGridTextColumn Header="Paid so far" Binding="{Binding PaidAmount}" Width="120"
                                    ElementStyle="{StaticResource NumericCell}"
                                    HeaderStyle="{StaticResource NumericColumnHeader}" />
                <DataGridTextColumn Header="Outstanding" Binding="{Binding OutstandingAmount}" Width="*"
                                    ElementStyle="{StaticResource NumericCell}"
                                    HeaderStyle="{StaticResource NumericColumnHeader}" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="6" Style="{StaticResource EntryPanelStyle}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Print / preview" Style="{StaticResource BandButton}"
                        Command="{Binding PrintCommand}" />
                <Button Content="Export CSV" Style="{StaticResource BandButton}"
                        Command="{Binding ExportCsvCommand}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="7" Style="{StaticResource PageStatusStyle}">
            <TextBlock Text="{Binding Status}" Style="{StaticResource PageStatusText}" />
        </Border>
    </Grid>
</UserControl>
