<UserControl x:Class="VinayakaAgencies.App.Views.DayBookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="900">

    <!-- Report page (ADR-0006). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Day book" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="cancelled vouchers are shown and flagged, never hidden (spec 8.4)"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="From" Style="{StaticResource FieldLabel}" />
                <DatePicker Width="140" Margin="0,0,16,0" VerticalAlignment="Center"
                            SelectedDate="{Binding FromDate}" />
                <TextBlock Text="To" Style="{StaticResource FieldLabel}" />
                <DatePicker Width="140" Margin="0,0,16,0" VerticalAlignment="Center"
                            SelectedDate="{Binding ToDate}" />
                <Button Content="Load" Style="{StaticResource BandButton}" Command="{Binding LoadCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <DataGrid Style="{StaticResource PageGrid}" ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow}">
                <DataGrid.RowStyle>
                    <!-- Cancelled vouchers stay in the book and are marked, not removed. -->
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                <Setter Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding VoucherDate, StringFormat=dd-MMM-yy}" Width="100" />
                    <DataGridTextColumn Header="Number" Binding="{Binding VoucherNumber}" Width="130" />
                    <DataGridTextColumn Header="Type" Binding="{Binding VoucherTypeName}" Width="130" />
                    <DataGridTextColumn Header="Ledger" Binding="{Binding LedgerName}" Width="2*" />
                    <DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat=N2}" Width="120"
                                        ElementStyle="{StaticResource NumericCell}"
                                        HeaderStyle="{StaticResource NumericColumnHeader}" />
                    <DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat=N2}" Width="120"
                                        ElementStyle="{StaticResource NumericCell}"
                                        HeaderStyle="{StaticResource NumericColumnHeader}" />
                    <DataGridTextColumn Header="Narration" Binding="{Binding Narration}" Width="*" />
                    <DataGridCheckBoxColumn Header="Cancelled" Binding="{Binding IsCancelled}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Style="{StaticResource EmptyStateText}"
                       Text="No vouchers in this period. Widen the dates and press Load."
                       Visibility="{Binding Rows.Count, Converter={StaticResource ZeroToVisibility}}" />
        </Grid>

        <!-- Ctrl+Enter fills this; it stays collapsed until then. -->
        <Border Grid.Row="3" Style="{StaticResource DrillDownBandStyle}"
                Visibility="{Binding VoucherRows.Count, Converter={StaticResource NonZeroToVisibility}}">
            <StackPanel>
                <TextBlock Text="THE WHOLE VOUCHER" Style="{StaticResource DrillDownHeadingText}" />
                <DataGrid Style="{StaticResource PageGrid}" ItemsSource="{Binding VoucherRows}"
                          MaxHeight="180" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Number" Binding="{Binding VoucherNumber}" Width="130" />
                        <DataGridTextColumn Header="Ledger" Binding="{Binding LedgerName}" Width="2*" />
                        <DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat=N2}" Width="120"
                                            ElementStyle="{StaticResource NumericCell}"
                                            HeaderStyle="{StaticResource NumericColumnHeader}" />
                        <DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat=N2}" Width="120"
                                            ElementStyle="{StaticResource NumericCell}"
                                            HeaderStyle="{StaticResource NumericColumnHeader}" />
                        <DataGridTextColumn Header="Narration" Binding="{Binding Narration}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource TotalsBandStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Dr" Style="{StaticResource TotalsLabelText}" />
                <TextBlock Text="{Binding TotalDebit, StringFormat=N2}" Style="{StaticResource TotalsValueText}" />
                <TextBlock Text="Cr" Style="{StaticResource TotalsLabelText}" />
                <TextBlock Text="{Binding TotalCredit, StringFormat=N2}" Style="{StaticResource TotalsValueText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource PageStatusStyle}">
            <TextBlock Text="{Binding Status}" Style="{StaticResource PageStatusText}" />
        </Border>
    </Grid>
</UserControl>
