<UserControl x:Class="VinayakaAgencies.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VinayakaAgencies.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DiagnosticsViewModel}">

    <StackPanel Margin="32,28" VerticalAlignment="Top">
        <TextBlock Text="Diagnostics"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#FF1B2A4A" />

        <TextBlock Margin="0,6,0,20"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="#FF5A6B85"
                   Text="The composition-root proof, kept as a live diagnostic: configuration, logging, the schema migration, and both database paths. The company count is read twice — once through EF Core and once through Dapper — and both must agree." />

        <Border Background="White"
                CornerRadius="10"
                Padding="20"
                BorderBrush="#FFE1E7EF"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Companies (repository / EF Core)"
                           FontSize="11"
                           Foreground="#FF7A8AA3" />
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{Binding CompanyCountViaRepository}"
                           FontSize="32"
                           FontWeight="Light"
                           Foreground="#FF12314F" />

                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="Companies (reporting / Dapper)"
                           FontSize="11"
                           Foreground="#FF7A8AA3" />
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding CompanyCountViaDapper}"
                           FontSize="32"
                           FontWeight="Light"
                           Foreground="#FF12314F" />
            </Grid>
        </Border>

        <!-- AsyncRelayCommand reports CanExecute = false while it is running, so the button
             disables itself during a refresh without a converter. -->
        <Button Content="Refresh"
                Margin="0,20,0,0"
                Padding="18,8"
                HorizontalAlignment="Left"
                Command="{Binding RefreshCommand}" />
    </StackPanel>
</UserControl>
