<UserControl x:Class="VinayakaAgencies.App.Views.EditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="980">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Edit log — view only; every change of every master and voucher, retained forever (MCA Rule 3(1))"
                   FontSize="16" FontWeight="SemiBold" Foreground="#FF1B2A4A" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,8">
            <Button Content="Load newest 200" Padding="12,5" Command="{Binding LoadCommand}" />
            <TextBlock Text="Entity type:" VerticalAlignment="Center" Margin="16,0,6,0" Foreground="#FF5A6B85" />
            <TextBox Width="130" Text="{Binding EntityTypeFilter, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Entity id:" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="#FF5A6B85" />
            <TextBox Width="260" Text="{Binding EntityIdFilter, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Filter" Margin="10,0,0,0" Padding="12,5" Command="{Binding LoadCommand}" />
            <Button Content="Verify hash chain" Margin="20,0,0,0" Padding="14,5" Command="{Binding VerifyChainCommand}" />
        </StackPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="SizeToCells" />
                <DataGridTextColumn Header="When (UTC)" Binding="{Binding OccurredAtUtc}" Width="SizeToCells" />
                <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="SizeToCells" />
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="SizeToHeader" />
                <DataGridTextColumn Header="Entity" Binding="{Binding EntityType}" Width="SizeToCells" />
                <DataGridTextColumn Header="Changed" Binding="{Binding ChangedProperties}" Width="2*" />
                <DataGridTextColumn Header="Before" Binding="{Binding BeforeJson}" Width="1.4*" MaxWidth="260" />
                <DataGridTextColumn Header="After" Binding="{Binding AfterJson}" Width="1.4*" MaxWidth="260" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Margin="4,8,0,0" Foreground="#FF5A6B85" TextWrapping="Wrap">
            <Run Text="{Binding Status, Mode=OneWay}" /><LineBreak />
            <Run Text="{Binding VerificationStatus, Mode=OneWay}" FontWeight="SemiBold" />
        </TextBlock>
    </Grid>
</UserControl>
