<UserControl x:Class="VinayakaAgencies.App.Views.EditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="980">

    <!-- Report page (ADR-0006). View only, by design: the edit log cannot be altered from anywhere. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Edit log" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="view only; every change of every master and voucher, retained forever (MCA Rule 3(1))"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Load newest 200" Style="{StaticResource BandButton}"
                        Command="{Binding LoadCommand}" />

                <TextBlock Text="Entity type" Style="{StaticResource FieldLabel}" />
                <TextBox Width="150" Style="{StaticResource FieldBox}"
                         Text="{Binding EntityTypeFilter, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Entity id" Style="{StaticResource FieldLabel}" />
                <TextBox Width="280" Style="{StaticResource FieldBox}"
                         Text="{Binding EntityIdFilter, UpdateSourceTrigger=PropertyChanged}" />

                <Button Content="Filter" Style="{StaticResource BandButton}" Command="{Binding LoadCommand}" />
                <Button Content="Verify hash chain" Style="{StaticResource BandButton}"
                        Command="{Binding VerifyChainCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <DataGrid Style="{StaticResource PageGrid}" ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="60"
                                        ElementStyle="{StaticResource NumericCell}"
                                        HeaderStyle="{StaticResource NumericColumnHeader}" />
                    <DataGridTextColumn Header="When (UTC)" Binding="{Binding OccurredAtUtc}" Width="160" />
                    <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="130" />
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="80" />
                    <DataGridTextColumn Header="Entity" Binding="{Binding EntityType}" Width="140" />
                    <DataGridTextColumn Header="Changed" Binding="{Binding ChangedProperties}" Width="2*" />
                    <DataGridTextColumn Header="Before" Binding="{Binding BeforeJson}" Width="1.4*" MaxWidth="260" />
                    <DataGridTextColumn Header="After" Binding="{Binding AfterJson}" Width="1.4*" MaxWidth="260" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Style="{StaticResource EmptyStateText}"
                       Text="Nothing logged for this filter. Press Load newest 200 to see recent activity."
                       Visibility="{Binding Rows.Count, Converter={StaticResource ZeroToVisibility}}" />
        </Grid>

        <!-- Ctrl+Enter fills this; the grid must truncate the images to stay readable, and a
             truncated before-image is the one thing this screen exists to show. -->
        <Border Grid.Row="3" Style="{StaticResource DrillDownBandStyle}"
                Visibility="{Binding DetailCaption, Converter={StaticResource NotNullToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding DetailCaption}" Style="{StaticResource DrillDownHeadingText}" />
                <Grid Margin="16,0,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding DetailBefore, Mode=OneWay}" IsReadOnly="True"
                             Margin="0,0,8,0" MaxHeight="150" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                    <TextBox Grid.Column="1" Text="{Binding DetailAfter, Mode=OneWay}" IsReadOnly="True"
                             MaxHeight="150" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource PageStatusStyle}">
            <StackPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource PageStatusText}" />
                <TextBlock Text="{Binding VerificationStatus}" FontWeight="SemiBold"
                           Style="{StaticResource PageStatusText}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
