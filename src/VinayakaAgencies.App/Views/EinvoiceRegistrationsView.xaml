<UserControl x:Class="VinayakaAgencies.App.Views.EinvoiceRegistrationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="E-invoice (IRN) — register posted tax invoices with the NIC portal"
                   Style="{StaticResource ScreenTitleText}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,8">
            <Button Content="Refresh" Padding="14,5" Command="{Binding RefreshCommand}" />
            <Button Content="Preview payload" Margin="10,0,0,0" Padding="14,5"
                    Command="{Binding PreviewPayloadCommand}" />
            <Button Content="Get IRN" Margin="10,0,0,0" Padding="14,5"
                    Command="{Binding GenerateCommand}" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Invoices}"
                      SelectedItem="{Binding SelectedInvoice}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource GridLineBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Invoice" Width="140" Binding="{Binding Number}" />
                    <DataGridTextColumn Header="Date" Width="100"
                                        Binding="{Binding DocumentDate, StringFormat=dd MMM yyyy}" />
                    <DataGridTextColumn Header="Party" Width="*" Binding="{Binding PartyName}" />
                    <DataGridTextColumn Header="Value" Width="110"
                                        Binding="{Binding TotalNetValue, StringFormat=N2}" />
                    <DataGridTextColumn Header="E-invoice" Width="120"
                                        Binding="{Binding RegistrationStatus}" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Width="1" Margin="14,0"
                    Background="{StaticResource ControlBorderBrush}" />

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Registration" Style="{StaticResource SectionHeaderText}" />

                    <TextBlock Text="IRN" Style="{StaticResource FieldLabelText}" Margin="0,8,0,2" />
                    <TextBox Text="{Binding Irn, Mode=OneWay}" IsReadOnly="True"
                             TextWrapping="Wrap" FontFamily="Consolas" />

                    <TextBlock Text="Status" Style="{StaticResource FieldLabelText}" Margin="0,10,0,2" />
                    <TextBlock Text="{Binding StatusText}" />

                    <TextBlock Text="Acknowledgement" Style="{StaticResource FieldLabelText}" Margin="0,10,0,2" />
                    <TextBlock Text="{Binding Acknowledgement}" />

                    <TextBlock Text="Cancellable until" Style="{StaticResource FieldLabelText}" Margin="0,10,0,2" />
                    <TextBlock Text="{Binding CancellableUntil}" />

                    <TextBlock Text="Signed QR (as returned by the portal)"
                               Style="{StaticResource FieldLabelText}" Margin="0,10,0,2" />
                    <TextBox Text="{Binding SignedQrCode, Mode=OneWay}" IsReadOnly="True"
                             Height="70" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" />

                    <TextBlock Text="Cancel at the portal" Style="{StaticResource SectionHeaderText}"
                               Margin="0,18,0,0" />

                    <TextBlock Text="Reason code" Style="{StaticResource FieldLabelText}" Margin="0,8,0,2" />
                    <TextBox Text="{Binding CancelReasonCode}" Width="80" HorizontalAlignment="Left" />

                    <TextBlock Text="Remarks" Style="{StaticResource FieldLabelText}" Margin="0,10,0,2" />
                    <TextBox Text="{Binding CancelRemarks}" />

                    <Button Content="Cancel IRN" Margin="0,12,0,0" Padding="14,5"
                            HorizontalAlignment="Left"
                            IsEnabled="{Binding CanCancel}"
                            Command="{Binding CancelIrnCommand}" />

                    <TextBlock Text="Payload preview" Style="{StaticResource SectionHeaderText}"
                               Margin="0,18,0,0" />
                    <TextBox Text="{Binding PayloadPreview, Mode=OneWay}" IsReadOnly="True"
                             Height="180" Margin="0,8,0,0"
                             FontFamily="Consolas" FontSize="11"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Style="{StaticResource StatusText}"
                   Margin="0,12,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
