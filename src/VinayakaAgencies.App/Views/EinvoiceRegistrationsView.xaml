<UserControl x:Class="VinayakaAgencies.App.Views.EinvoiceRegistrationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">

    <!-- Report page with a side detail panel (ADR-0006): invoices on the left, the selected
         invoice's registration on the right. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="E-invoice (IRN)" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="register posted tax invoices with the NIC portal"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Refresh" Style="{StaticResource BandButton}" Command="{Binding RefreshCommand}" />
                <Button Content="Preview payload" Style="{StaticResource BandButton}"
                        ToolTip="Assembles what would be sent, without contacting the portal."
                        Command="{Binding PreviewPayloadCommand}" />
                <Button Content="Get IRN" Style="{StaticResource BandButton}"
                        ToolTip="Idempotent: pressing this twice reports the existing registration rather than creating a second."
                        Command="{Binding GenerateCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <DataGrid Style="{StaticResource PageGrid}"
                          ItemsSource="{Binding Invoices}"
                          SelectedItem="{Binding SelectedInvoice}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Invoice" Binding="{Binding Number}" Width="140" />
                        <DataGridTextColumn Header="Date" Binding="{Binding DocumentDate, StringFormat=dd MMM yyyy}" Width="110" />
                        <DataGridTextColumn Header="Party" Binding="{Binding PartyName}" Width="*" />
                        <DataGridTextColumn Header="Value" Binding="{Binding TotalNetValue, StringFormat=N2}" Width="120"
                                            ElementStyle="{StaticResource NumericCell}"
                                            HeaderStyle="{StaticResource NumericColumnHeader}" />
                        <DataGridTextColumn Header="E-invoice" Binding="{Binding RegistrationStatus}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Style="{StaticResource EmptyStateText}"
                           Text="No posted tax invoices. Only a posted, numbered invoice can be registered — the IRN is computed from its number."
                           Visibility="{Binding Invoices.Count, Converter={StaticResource ZeroToVisibility}}" />
            </Grid>

            <Border Grid.Column="1" Width="1" Background="{StaticResource ControlBorderBrush}" />

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,12,16,12">
                    <TextBlock Text="REGISTRATION" Style="{StaticResource EntryHeadingText}" />

                    <TextBlock Text="IRN" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                    <TextBox Text="{Binding Irn, Mode=OneWay}" IsReadOnly="True"
                             TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" />

                    <TextBlock Text="Status" Style="{StaticResource FieldLabel}" Margin="0,10,0,3" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource PrimaryTextBrush}" />

                    <TextBlock Text="Acknowledgement" Style="{StaticResource FieldLabel}" Margin="0,10,0,3" />
                    <TextBlock Text="{Binding Acknowledgement}" Foreground="{StaticResource PrimaryTextBrush}" />

                    <TextBlock Text="Cancellable until" Style="{StaticResource FieldLabel}" Margin="0,10,0,3" />
                    <TextBlock Text="{Binding CancellableUntil}" Foreground="{StaticResource PrimaryTextBrush}" />

                    <TextBlock Text="Signed QR, as returned by the portal"
                               Style="{StaticResource FieldLabel}" Margin="0,10,0,3" />
                    <TextBox Text="{Binding SignedQrCode, Mode=OneWay}" IsReadOnly="True"
                             Height="70" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" />

                    <TextBlock Text="CANCEL AT THE PORTAL" Style="{StaticResource EntryHeadingText}" Margin="0,18,0,7" />

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Reason code" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="80" MinWidth="0" Style="{StaticResource FieldBox}"
                                 Text="{Binding CancelReasonCode}" />
                    </StackPanel>

                    <TextBlock Text="Remarks" Style="{StaticResource FieldLabel}" Margin="0,8,0,3" />
                    <TextBox Text="{Binding CancelRemarks}" />

                    <Button Content="Cancel IRN" Margin="0,12,0,0" HorizontalAlignment="Left"
                            Style="{StaticResource BandButton}"
                            IsEnabled="{Binding CanCancel}"
                            Command="{Binding CancelIrnCommand}" />

                    <TextBlock Text="PAYLOAD PREVIEW" Style="{StaticResource EntryHeadingText}" Margin="0,18,0,7" />
                    <TextBox Text="{Binding PayloadPreview, Mode=OneWay}" IsReadOnly="True"
                             Height="180" FontFamily="Consolas" FontSize="11"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource PageStatusStyle}">
            <TextBlock Text="{Binding Status}" Style="{StaticResource PageStatusText}" />
        </Border>
    </Grid>
</UserControl>
