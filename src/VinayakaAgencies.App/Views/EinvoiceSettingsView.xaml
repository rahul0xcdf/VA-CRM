<UserControl x:Class="VinayakaAgencies.App.Views.EinvoiceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="820">

    <!-- Settings page (ADR-0006). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="E-invoice settings" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="applicability, environment and NIC credentials"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource SettingsSectionStyle}">
                    <StackPanel>
                        <TextBlock Text="APPLICABILITY" Style="{StaticResource EntryHeadingText}" />

                        <CheckBox Content="E-invoicing applies to this business"
                                  IsChecked="{Binding IsEinvoicingApplicable}" />
                        <TextBlock Style="{StaticResource SettingsCaptionText}"
                                   Text="Turn this on only if the business is above the e-invoicing turnover threshold. Turnover is a fact about the business, so it is declared here rather than guessed from the books." />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="E-way bill threshold ₹" Style="{StaticResource FieldLabel}" />
                            <TextBox Width="160" Style="{StaticResource FieldBox}"
                                     Text="{Binding EwayBillThreshold}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SettingsCaptionText}"
                                   Text="A consignment must exceed this value before a bill is required. Stored as data rather than built into the software, because the statutory figure has moved before." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsSectionStyle}">
                    <StackPanel>
                        <TextBlock Text="PORTAL ENVIRONMENT" Style="{StaticResource EntryHeadingText}" />

                        <CheckBox Content="Use the production portal" IsChecked="{Binding UseProduction}" />
                        <TextBlock Style="{StaticResource SettingsCaptionText}"
                                   Foreground="{StaticResource WarningBrush}"
                                   Text="Leave this off until sandbox testing is signed off. Production files real invoices with the government portal, and an IRN cannot be withdrawn after 24 hours." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsSectionStyle}">
                    <StackPanel>
                        <TextBlock Text="NIC CREDENTIALS" Style="{StaticResource EntryHeadingText}" />

                        <TextBlock Text="{Binding CredentialState}" Foreground="{StaticResource PrimaryTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource SettingsCaptionText}"
                                   Text="Stored values are never shown back, not even masked. To change them, enter all four again. They are encrypted for the Windows user that entered them, so they must be re-entered if the app runs as a different user." />

                        <Grid Margin="0,14,0,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Client id" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" Text="{Binding ClientId}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Client secret" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Text="{Binding ClientSecret}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Username" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" Text="{Binding Username}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Password" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Password}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Store credentials" Style="{StaticResource BandButton}"
                                    Command="{Binding SaveCredentialsCommand}" />
                            <Button Content="Clear credentials" Style="{StaticResource BandButton}"
                                    IsEnabled="{Binding HasCredentials}"
                                    Command="{Binding ClearCredentialsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource EntryPanelStyle}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Save settings" Style="{StaticResource BandButton}" Command="{Binding SaveCommand}" />
                <Button Content="Reload" Style="{StaticResource BandButton}" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource PageStatusStyle}">
            <TextBlock Text="{Binding Status}" Style="{StaticResource PageStatusText}" />
        </Border>
    </Grid>
</UserControl>
