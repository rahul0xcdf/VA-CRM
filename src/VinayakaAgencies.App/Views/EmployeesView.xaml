<UserControl x:Class="VinayakaAgencies.App.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:VinayakaAgencies.App.Presentation.Controls"
             mc:Ignorable="d"
             d:DesignHeight="680" d:DesignWidth="1150">

    <!--
        Master-list page (ADR-0006 shape, ADR-0007 internals). The structure grid on the right is
        history: a raise appends a dated line, so an earlier month's pay slip stays reproducible.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Employees" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="and each person's salary structure, dated"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="Show inactive" Style="{StaticResource FieldCheck}"
                          IsChecked="{Binding IncludeInactive}" />
                <Button Content="Refresh" Style="{StaticResource BandButton}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <DataGrid Style="{StaticResource PageGrid}"
                          ItemsSource="{Binding Employees}"
                          SelectedItem="{Binding SelectedEmployee}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="80" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Designation" Binding="{Binding Designation}" Width="140" />
                        <DataGridTextColumn Header="PAN" Binding="{Binding Pan}" Width="110" />
                        <DataGridTextColumn Header="UAN" Binding="{Binding Uan}" Width="120" />
                        <DataGridTextColumn Header="Joined" Binding="{Binding JoinedOn}" Width="100" />
                        <DataGridTextColumn Header="Left" Binding="{Binding LeftOn}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Style="{StaticResource EmptyStateText}"
                           Text="No employees yet."
                           Visibility="{Binding Employees.Count, Converter={StaticResource ZeroToVisibility}}" />
            </Grid>

            <DataGrid Grid.Column="1" Style="{StaticResource PageGrid}"
                      ItemsSource="{Binding Structure}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Pay head" Binding="{Binding PayHeadName}" Width="*" />
                    <DataGridTextColumn Header="Basis" Binding="{Binding Basis}" Width="110" />
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="100"
                                        ElementStyle="{StaticResource NumericCell}"
                                        HeaderStyle="{StaticResource NumericColumnHeader}" />
                    <DataGridTextColumn Header="From" Binding="{Binding EffectiveFrom}" Width="100" />
                    <DataGridTextColumn Header="To" Binding="{Binding EffectiveTo}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource EntryPanelStyle}">
            <StackPanel>
                <TextBlock Text="EMPLOYEE" Style="{StaticResource EntryHeadingText}" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Code" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="90" Style="{StaticResource FieldBox}"
                             Text="{Binding EditCode, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="220" Style="{StaticResource FieldBox}"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Designation" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="160" Style="{StaticResource FieldBox}"
                             Text="{Binding EditDesignation, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Joined" Style="{StaticResource FieldLabel}" />
                    <DatePicker Width="120" SelectedDate="{Binding EditJoinedOn}" />

                    <TextBlock Text="Last day" Style="{StaticResource FieldLabel}" />
                    <DatePicker Width="120" SelectedDate="{Binding EditLeftOn}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="PAN" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="120" Style="{StaticResource FieldBox}"
                             Text="{Binding EditPan, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="UAN" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="140" Style="{StaticResource FieldBox}"
                             Text="{Binding EditUan, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="ESI number" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="150" Style="{StaticResource FieldBox}"
                             Text="{Binding EditEsiNumber, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Content="Save" Style="{StaticResource BandButton}"
                            Command="{Binding SaveCommand}" />
                    <Button Content="New" Style="{StaticResource BandButton}"
                            Command="{Binding ClearEditorCommand}" />
                    <Border Width="1" Margin="4,2,12,2" Background="{StaticResource ControlBorderBrush}" />
                    <Button Content="Deactivate" Style="{StaticResource BandButton}"
                            Command="{Binding DeactivateSelectedCommand}" />
                </StackPanel>

                <TextBlock Text="SALARY STRUCTURE — FROM A DATE" Style="{StaticResource EntryHeadingText}"
                           Margin="0,10,0,0" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Pay head" Style="{StaticResource FieldLabel}" />
                    <controls:LookupBox Style="{StaticResource FieldLookup}" Width="230"
                                        Watermark="Type any part of the name"
                                        DisplayMemberPath="Name"
                                        ItemsSource="{Binding PayHeadChoices}"
                                        SelectedItem="{Binding StructurePayHead, Mode=TwoWay}" />

                    <TextBlock Text="Amount" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="110" Style="{StaticResource FieldBox}"
                             Text="{Binding StructureAmount, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="or %" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="80" Style="{StaticResource FieldBox}"
                             Text="{Binding StructurePercent, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="From" Style="{StaticResource FieldLabel}" />
                    <DatePicker Width="120" SelectedDate="{Binding StructureEffectiveFrom}" />

                    <Button Content="Add line" Style="{StaticResource BandButton}"
                            Command="{Binding AddStructureLineCommand}" />
                </StackPanel>

                <TextBlock Style="{StaticResource PageHintText}" Margin="0,8,0,0"
                           Text="A statutory head takes neither figure — its rate, ceiling or slab rows produce it." />
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource PageStatusStyle}">
            <TextBlock Text="{Binding Status}" Style="{StaticResource PageStatusText}" />
        </Border>
    </Grid>
</UserControl>
