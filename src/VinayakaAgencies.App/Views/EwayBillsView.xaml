<UserControl x:Class="VinayakaAgencies.App.Views.EwayBillsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="660" d:DesignWidth="1150">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="E-way bills — generated by IRN, with Part-B kept current"
                   Style="{StaticResource ScreenTitleText}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,8">
            <Button Content="Refresh" Padding="14,5" Command="{Binding RefreshCommand}" />
            <Button Content="Generate" Margin="10,0,0,0" Padding="14,5" Command="{Binding GenerateCommand}" />
            <Button Content="Update Part-B" Margin="10,0,0,0" Padding="14,5"
                    Command="{Binding UpdatePartBCommand}" />
            <Button Content="Extend validity" Margin="10,0,0,0" Padding="14,5"
                    Command="{Binding ExtendCommand}" />
            <Button Content="Cancel bill" Margin="10,0,0,0" Padding="14,5"
                    IsEnabled="{Binding CanCancel}" Command="{Binding CancelBillCommand}" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Invoices}"
                      SelectedItem="{Binding SelectedInvoice}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource GridLineBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Document" Width="140" Binding="{Binding Number}" />
                    <DataGridTextColumn Header="Date" Width="100"
                                        Binding="{Binding DocumentDate, StringFormat=dd MMM yyyy}" />
                    <DataGridTextColumn Header="Party" Width="*" Binding="{Binding PartyName}" />
                    <DataGridTextColumn Header="Value" Width="110"
                                        Binding="{Binding TotalNetValue, StringFormat=N2}" />
                    <DataGridTextColumn Header="E-way bill" Width="120" Binding="{Binding EwayBillState}" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Width="1" Margin="14,0"
                    Background="{StaticResource ControlBorderBrush}" />

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding Requirement}" TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}" />

                    <TextBlock Text="Part-A" Style="{StaticResource SectionHeaderText}" Margin="0,14,0,0" />

                    <TextBlock Text="E-way bill number" Style="{StaticResource FieldLabelText}" Margin="0,8,0,2" />
                    <TextBlock Text="{Binding BillNumber}" FontFamily="Consolas" />

                    <TextBlock Text="Status" Style="{StaticResource FieldLabelText}" Margin="0,10,0,2" />
                    <TextBlock Text="{Binding BillStatus}" />

                    <TextBlock Text="Valid until" Style="{StaticResource FieldLabelText}" Margin="0,10,0,2" />
                    <TextBlock Text="{Binding ValidUntil}" />

                    <TextBlock Text="Part-B — transport" Style="{StaticResource SectionHeaderText}"
                               Margin="0,18,0,0" />

                    <TextBlock Text="{Binding PartBRequirement}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Mode" Style="{StaticResource FieldLabelText}" />
                            <ComboBox ItemsSource="{Binding TransportModes}"
                                      SelectedItem="{Binding SelectedTransportMode}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Vehicle type" Style="{StaticResource FieldLabelText}" />
                            <ComboBox ItemsSource="{Binding VehicleTypes}"
                                      SelectedItem="{Binding SelectedVehicleType}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                            <TextBlock Text="Distance (km)" Style="{StaticResource FieldLabelText}" />
                            <TextBox Text="{Binding DistanceKilometres, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
                            <TextBlock Text="Vehicle number" Style="{StaticResource FieldLabelText}" />
                            <TextBox Text="{Binding VehicleNumber}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,10,0,0">
                            <TextBlock Text="Transporter GSTIN" Style="{StaticResource FieldLabelText}" />
                            <TextBox Text="{Binding TransporterGstin}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,10,0,0">
                            <TextBlock Text="Transporter name" Style="{StaticResource FieldLabelText}" />
                            <TextBox Text="{Binding TransporterName}" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,10,0,0">
                            <TextBlock Text="Transport doc no." Style="{StaticResource FieldLabelText}" />
                            <TextBox Text="{Binding TransportDocumentNumber}" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,10,0,0">
                            <TextBlock Text="Transport doc date" Style="{StaticResource FieldLabelText}" />
                            <DatePicker SelectedDate="{Binding TransportDocumentDate}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding ExpectedValidity}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}" />

                    <TextBlock Text="Cancel or extend" Style="{StaticResource SectionHeaderText}"
                               Margin="0,18,0,0" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Reason code" Style="{StaticResource FieldLabelText}" />
                            <TextBox Text="{Binding ReasonCode}" Width="80" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Remarks" Style="{StaticResource FieldLabelText}" />
                            <TextBox Text="{Binding Remarks}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Style="{StaticResource StatusText}"
                   Margin="0,12,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
