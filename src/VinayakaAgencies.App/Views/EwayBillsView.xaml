<UserControl x:Class="VinayakaAgencies.App.Views.EwayBillsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="660" d:DesignWidth="1150">

    <!-- Report page with a side detail panel (ADR-0006): movable documents on the left, Part-A and
         Part-B for the selected one on the right. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="E-way bills" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="generated by IRN, with Part-B kept current"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Refresh" Style="{StaticResource BandButton}" Command="{Binding RefreshCommand}" />
                <Button Content="Generate" Style="{StaticResource BandButton}" Command="{Binding GenerateCommand}" />
                <Button Content="Update Part-B" Style="{StaticResource BandButton}"
                        Command="{Binding UpdatePartBCommand}" />
                <Button Content="Extend validity" Style="{StaticResource BandButton}"
                        Command="{Binding ExtendCommand}" />
                <Button Content="Cancel bill" Style="{StaticResource BandButton}"
                        IsEnabled="{Binding CanCancel}" Command="{Binding CancelBillCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="450" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <DataGrid Style="{StaticResource PageGrid}"
                          ItemsSource="{Binding Invoices}"
                          SelectedItem="{Binding SelectedInvoice}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Document" Binding="{Binding Number}" Width="140" />
                        <DataGridTextColumn Header="Date" Binding="{Binding DocumentDate, StringFormat=dd MMM yyyy}" Width="110" />
                        <DataGridTextColumn Header="Party" Binding="{Binding PartyName}" Width="*" />
                        <DataGridTextColumn Header="Value" Binding="{Binding TotalNetValue, StringFormat=N2}" Width="120"
                                            ElementStyle="{StaticResource NumericCell}"
                                            HeaderStyle="{StaticResource NumericColumnHeader}" />
                        <DataGridTextColumn Header="E-way bill" Binding="{Binding EwayBillState}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Style="{StaticResource EmptyStateText}"
                           Text="No posted invoices or challans to move."
                           Visibility="{Binding Invoices.Count, Converter={StaticResource ZeroToVisibility}}" />
            </Grid>

            <Border Grid.Column="1" Width="1" Background="{StaticResource ControlBorderBrush}" />

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,12,16,12">
                    <TextBlock Text="{Binding Requirement}" TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}" />

                    <TextBlock Text="PART-A" Style="{StaticResource EntryHeadingText}" Margin="0,14,0,7" />

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Bill number" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding BillNumber}" FontFamily="Consolas"
                                   Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Status" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding BillStatus}" Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Valid until" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding ValidUntil}" Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="PART-B — TRANSPORT" Style="{StaticResource EntryHeadingText}" Margin="0,18,0,7" />

                    <TextBlock Text="{Binding PartBRequirement}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{StaticResource SecondaryTextBrush}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Mode" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding TransportModes}"
                                      SelectedItem="{Binding SelectedTransportMode}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Vehicle type" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding VehicleTypes}"
                                      SelectedItem="{Binding SelectedVehicleType}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                            <TextBlock Text="Distance (km)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding DistanceKilometres, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0">
                            <TextBlock Text="Vehicle number" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding VehicleNumber}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,8,0,0">
                            <TextBlock Text="Transporter GSTIN" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding TransporterGstin}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,8,0,0">
                            <TextBlock Text="Transporter name" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding TransporterName}" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,8,0,0">
                            <TextBlock Text="Transport doc no." Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding TransportDocumentNumber}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,8,0,0">
                            <TextBlock Text="Transport doc date" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding TransportDocumentDate}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding ExpectedValidity}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}" />

                    <TextBlock Text="CANCEL OR EXTEND" Style="{StaticResource EntryHeadingText}" Margin="0,18,0,7" />

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Reason code" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="80" MinWidth="0" Style="{StaticResource FieldBox}"
                                 Text="{Binding ReasonCode}" />
                    </StackPanel>

                    <TextBlock Text="Remarks" Style="{StaticResource FieldLabel}" Margin="0,8,0,3" />
                    <TextBox Text="{Binding Remarks}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource PageStatusStyle}">
            <TextBlock Text="{Binding Status}" Style="{StaticResource PageStatusText}" />
        </Border>
    </Grid>
</UserControl>
