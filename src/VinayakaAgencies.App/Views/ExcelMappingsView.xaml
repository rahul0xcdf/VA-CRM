<UserControl x:Class="VinayakaAgencies.App.Views.ExcelMappingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="1020">

    <!--
        Master page: the saved list on the left, the editor on the right. The editor's grid is a
        list of the sheet's own columns against the field each one feeds — the rows come from a real
        sheet rather than being typed, which is what stops a mapping naming a column that is spelled
        differently in the file.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Column mappings" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="which column of your sheet is which field — saved, so the next import is two keystrokes"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" Style="{StaticResource PageGrid}"
                      ItemsSource="{Binding Saved}" SelectedItem="{Binding Selected}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mapping" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Brings in" Binding="{Binding Target}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Style="{StaticResource SectionBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="220" Style="{StaticResource FieldBox}"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Brings in" Style="{StaticResource FieldLabel}" Margin="16,0,0,0" />
                        <ComboBox Width="150" Style="{StaticResource FieldCombo}"
                                  ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Sheet" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="180" Style="{StaticResource FieldCombo}" IsEditable="True"
                                  ItemsSource="{Binding Sheets}" Text="{Binding SheetName}" />

                        <TextBlock Text="Header row" Style="{StaticResource FieldLabel}" Margin="16,0,0,0" />
                        <TextBox Width="60" Style="{StaticResource FieldBox}"
                                 Text="{Binding HeaderRowNumber, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Content="Read a sheet (Alt+F)" Style="{StaticResource BandButton}" Margin="16,0,0,0"
                                Command="{Binding ReadSheetCommand}" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="{Binding MissingRequired}" Margin="0,0,0,8"
                               Foreground="{StaticResource WarningBrush}"
                               Visibility="{Binding MissingRequired, Converter={StaticResource EmptyStringToVisibility}}" />

                    <DataGrid Grid.Row="3" Style="{StaticResource PageGrid}"
                              ItemsSource="{Binding Columns}" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Column in your sheet"
                                                Binding="{Binding SourceHeader, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*" />
                            <DataGridComboBoxColumn Header="Fills this field"
                                                    SelectedItemBinding="{Binding TargetField, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="220">
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource" Value="{Binding AvailableFields}" />
                                    </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource" Value="{Binding AvailableFields}" />
                                    </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PageStatusStyle}">
            <TextBlock Text="{Binding Status}" Style="{StaticResource PageStatusText}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
