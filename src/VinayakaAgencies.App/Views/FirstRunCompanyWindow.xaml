<Window x:Class="VinayakaAgencies.App.Views.FirstRunCompanyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VinayakaAgencies.App.Presentation.Controls"
        Title="Welcome — create your company"
        Width="580" Height="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}">

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Welcome to Vinayaka Agencies"
                       Style="{StaticResource ScreenTitleText}" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="There are no books on this install yet. A company carries the legal name and state code that appear on filed returns, so it is created here, once, with real details — together with the account you will sign in under." />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Trading name:" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4"
                     Text="{Binding TradingName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Legal name:" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4"
                     Text="{Binding LegalName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="State (GST):" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,4"
                      ItemsSource="{Binding States}"
                      SelectedItem="{Binding SelectedState}"
                      DisplayMemberPath="Name" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="GSTIN (optional):" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4"
                     Text="{Binding Gstin, UpdateSourceTrigger=PropertyChanged}" />

            <!--
                The owner account is collected here rather than at the sign-in window so that a
                brand-new install is never in the unsecured state: until one account exists, every
                permission is granted to everybody.
            -->
            <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Margin="0,18,0,2"
                       Text="YOUR ACCOUNT"
                       Style="{StaticResource EntryHeadingText}" />
            <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Margin="0,0,0,6" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Every voucher and correction is recorded against the person who made it. Nothing is seeded — there is no default account and no default password." />

            <TextBlock Grid.Row="6" Grid.Column="0" Text="User name:" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBox Grid.Row="6" Grid.Column="1" Margin="0,4"
                     Text="{Binding OwnerUserName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Password:" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <PasswordBox Grid.Row="7" Grid.Column="1" Margin="0,4"
                         controls:PasswordBoxBinding.BoundPassword="{Binding OwnerPassword, Mode=TwoWay}" />

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Again:" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <PasswordBox Grid.Row="8" Grid.Column="1" Margin="0,4"
                         controls:PasswordBoxBinding.BoundPassword="{Binding OwnerPasswordAgain, Mode=TwoWay}" />
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <Button Content="Create company &amp; open books"
                    Padding="18,7"
                    HorizontalAlignment="Left"
                    Command="{Binding CreateCommand}" />

            <TextBlock Margin="2,10,0,0" Text="{Binding Status}" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
    </Grid>
</Window>
