<Window x:Class="VinayakaAgencies.App.Views.GoToPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Go To"
        Width="440" Height="430"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}"
        BorderBrush="{StaticResource ControlBorderBrush}"
        BorderThickness="1">

    <!-- ADR-0005: the Alt+G command palette — type to filter every registered screen,
         arrows to move, Enter to open, Esc to close. Pure input routing lives in the
         code-behind; navigation itself goes through ShellViewModel. -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:Name="FilterBox" Grid.Row="0"
                 FontSize="{StaticResource FontSize.Subheading}"
                 ToolTip="Type part of a screen or module name" />

        <ListBox x:Name="Results" Grid.Row="1" Margin="0,8,0,0"
                 ItemContainerStyle="{StaticResource HomeMenuItemContainerStyle}"
                 BorderBrush="{StaticResource ControlBorderBrush}"
                 BorderThickness="1"
                 MouseDoubleClick="OnResultsMouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ModuleNumber}" Width="16"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding Screen.Header}" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="{Binding Group, StringFormat=· {0}}" Margin="8,0,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" Margin="2,8,0,0"
                   Style="{StaticResource StatusHintText}"
                   Text="↑ ↓ move · Enter open · Esc close" />
    </Grid>
</Window>
