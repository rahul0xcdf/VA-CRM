<UserControl x:Class="VinayakaAgencies.App.Views.GstRateSchedulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="900">

    <!-- Master-list page (ADR-0006). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="GST rate schedules" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="dated rows per code; a new row supersedes the open one and history is never edited"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Code" Style="{StaticResource FieldLabel}" />
                <ComboBox Width="170" Style="{StaticResource FieldCombo}"
                          ItemsSource="{Binding CodeChoices}"
                          SelectedItem="{Binding SelectedCode}" DisplayMemberPath="Code" />

                <Button Content="Refresh codes" Style="{StaticResource BandButton}"
                        Command="{Binding RefreshCommand}" />
                <Button Content="Show all histories" Style="{StaticResource BandButton}"
                        Command="{Binding LoadHistoryCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <DataGrid Style="{StaticResource PageGrid}" ItemsSource="{Binding ScheduleRows}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Effective from" Binding="{Binding EffectiveFrom}" Width="130" />
                    <DataGridTextColumn Header="Effective to" Binding="{Binding EffectiveTo}" Width="130" />
                    <DataGridTextColumn Header="Rate %" Binding="{Binding RatePercent}" Width="90"
                                        ElementStyle="{StaticResource NumericCell}"
                                        HeaderStyle="{StaticResource NumericColumnHeader}" />
                    <DataGridTextColumn Header="Cess %" Binding="{Binding CessPercent}" Width="*"
                                        ElementStyle="{StaticResource NumericCell}"
                                        HeaderStyle="{StaticResource NumericColumnHeader}" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Style="{StaticResource EmptyStateText}"
                       Text="No rate rows for this code. Add one below — rates are data, never built into the software."
                       Visibility="{Binding ScheduleRows.Count, Converter={StaticResource ZeroToVisibility}}" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource EntryPanelStyle}">
            <StackPanel>
                <TextBlock Text="ADD A DATED RATE" Style="{StaticResource EntryHeadingText}" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Rate %" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="80" MinWidth="0" Style="{StaticResource FieldBox}"
                             Text="{Binding EditRatePercent, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Cess %" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="80" MinWidth="0" Style="{StaticResource FieldBox}"
                             Text="{Binding EditCessPercent, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Effective from" Style="{StaticResource FieldLabel}" />
                    <DatePicker Width="140" Margin="0,0,16,0" VerticalAlignment="Center"
                                SelectedDate="{Binding EditEffectiveFrom}" />

                    <Button Content="Add schedule" Style="{StaticResource BandButton}"
                            Command="{Binding AddScheduleCommand}" />
                </StackPanel>

                <TextBlock Margin="0,7,0,0" Style="{StaticResource SettingsCaptionText}"
                           Text="Adding a row closes the previous open-ended row the day before the new one starts, so exactly one rate covers any given date." />
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource PageStatusStyle}">
            <TextBlock Text="{Binding Status}" Style="{StaticResource PageStatusText}" />
        </Border>
    </Grid>
</UserControl>
