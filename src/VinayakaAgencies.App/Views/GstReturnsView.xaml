<UserControl x:Class="VinayakaAgencies.App.Views.GstReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1020">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="GST returns — built from posted invoices for one month of the open financial year"
                   Style="{StaticResource ScreenTitleText}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,8">
            <TextBlock Text="Period:" Style="{StaticResource FieldLabelText}" />
            <ComboBox Width="130" Margin="6,0,16,0" ItemsSource="{Binding PeriodChoices}"
                      SelectedItem="{Binding SelectedPeriod}" ItemStringFormat="MMM yyyy" />
            <TextBlock Text="Return:" Style="{StaticResource FieldLabelText}" />
            <ComboBox Width="110" Margin="6,0,16,0" ItemsSource="{Binding ReturnTypeChoices}"
                      SelectedItem="{Binding SelectedReturnType}" />
            <Button Content="Load" Padding="16,5" Command="{Binding LoadCommand}" />
            <Button Content="Export GSTR-1 JSON…" Margin="16,0,0,0" Padding="14,5"
                    Command="{Binding ExportGstr1JsonCommand}" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource SectionBorderStyle}" Margin="0,4,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Taxable:" Style="{StaticResource FieldLabelText}" />
                <TextBlock Text="{Binding TotalTaxable, StringFormat=N2}" Margin="6,0,16,0" FontWeight="SemiBold" />
                <TextBlock Text="IGST:" Style="{StaticResource FieldLabelText}" />
                <TextBlock Text="{Binding TotalIgst, StringFormat=N2}" Margin="6,0,16,0" FontWeight="SemiBold" />
                <TextBlock Text="CGST:" Style="{StaticResource FieldLabelText}" />
                <TextBlock Text="{Binding TotalCgst, StringFormat=N2}" Margin="6,0,16,0" FontWeight="SemiBold" />
                <TextBlock Text="SGST:" Style="{StaticResource FieldLabelText}" />
                <TextBlock Text="{Binding TotalSgst, StringFormat=N2}" Margin="6,0,16,0" FontWeight="SemiBold" />
                <TextBlock Text="Cess:" Style="{StaticResource FieldLabelText}" />
                <TextBlock Text="{Binding TotalCess, StringFormat=N2}" Margin="6,0,16,0" FontWeight="SemiBold" />
                <TextBlock Text="Total tax:" Style="{StaticResource FieldLabelText}" />
                <TextBlock Text="{Binding TotalTax, StringFormat=N2}" FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <!-- GSTR-1: B2B invoice list, B2C aggregates and the Table-12 HSN split. -->
            <ScrollViewer Visibility="{Binding IsGstr1, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="B2B invoices (per rate line)" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,4" />
                    <DataGrid ItemsSource="{Binding B2bRows}" MaxHeight="220"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="SizeToCells" />
                            <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate}" Width="SizeToCells" />
                            <DataGridTextColumn Header="Counterparty GSTIN" Binding="{Binding CounterpartyGstin}" Width="SizeToHeader" />
                            <DataGridTextColumn Header="POS" Binding="{Binding PlaceOfSupply}" Width="SizeToCells" />
                            <DataGridTextColumn Header="RCM" Binding="{Binding ReverseCharge}" Width="SizeToCells" />
                            <DataGridTextColumn Header="Rate %" Binding="{Binding RatePercent}" Width="SizeToCells" />
                            <DataGridTextColumn Header="Taxable" Binding="{Binding TaxableValue, StringFormat=N2}" Width="SizeToCells" />
                            <DataGridTextColumn Header="IGST" Binding="{Binding Igst, StringFormat=N2}" Width="SizeToCells" />
                            <DataGridTextColumn Header="CGST" Binding="{Binding Cgst, StringFormat=N2}" Width="SizeToCells" />
                            <DataGridTextColumn Header="SGST" Binding="{Binding Sgst, StringFormat=N2}" Width="SizeToCells" />
                            <DataGridTextColumn Header="Cess" Binding="{Binding Cess, StringFormat=N2}" Width="SizeToCells" />
                            <DataGridTextColumn Header="Invoice value" Binding="{Binding InvoiceValue, StringFormat=N2}" Width="SizeToCells" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="B2C aggregates by place of supply and rate" Style="{StaticResource SectionHeaderText}"
                               Margin="0,12,0,4" />
                    <DataGrid ItemsSource="{Binding B2cRows}" MaxHeight="180"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="POS" Binding="{Binding PlaceOfSupply}" Width="SizeToCells" />
                            <DataGridTextColumn Header="Rate %" Binding="{Binding RatePercent}" Width="SizeToCells" />
                            <DataGridTextColumn Header="Invoices" Binding="{Binding InvoiceCount}" Width="SizeToCells" />
                            <DataGridTextColumn Header="Taxable" Binding="{Binding TaxableValue, StringFormat=N2}" Width="SizeToCells" />
                            <DataGridTextColumn Header="IGST" Binding="{Binding Igst, StringFormat=N2}" Width="SizeToCells" />
                            <DataGridTextColumn Header="CGST" Binding="{Binding Cgst, StringFormat=N2}" Width="SizeToCells" />
                            <DataGridTextColumn Header="SGST" Binding="{Binding Sgst, StringFormat=N2}" Width="SizeToCells" />
                            <DataGridTextColumn Header="Cess" Binding="{Binding Cess, StringFormat=N2}" Width="SizeToCells" />
                            <DataGridTextColumn Header="Invoice value" Binding="{Binding InvoiceValue, StringFormat=N2}" Width="SizeToCells" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Table 12 — HSN summary, split B2B/B2C" Style="{StaticResource SectionHeaderText}"
                               Margin="0,12,0,4" />
                    <DataGrid ItemsSource="{Binding HsnRows}" MaxHeight="220"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="SizeToCells" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="1.5*" />
                            <DataGridTextColumn Header="Supply" Binding="{Binding SupplyType}" Width="SizeToCells" />
                            <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat=0.####}" Width="SizeToCells" />
                            <DataGridTextColumn Header="Taxable" Binding="{Binding TaxableValue, StringFormat=N2}" Width="SizeToCells" />
                            <DataGridTextColumn Header="IGST" Binding="{Binding Igst, StringFormat=N2}" Width="SizeToCells" />
                            <DataGridTextColumn Header="CGST" Binding="{Binding Cgst, StringFormat=N2}" Width="SizeToCells" />
                            <DataGridTextColumn Header="SGST" Binding="{Binding Sgst, StringFormat=N2}" Width="SizeToCells" />
                            <DataGridTextColumn Header="Cess" Binding="{Binding Cess, StringFormat=N2}" Width="SizeToCells" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="{Binding DocumentsSummary}" Style="{StaticResource StatusText}" Margin="0,8,0,8" />
                </StackPanel>
            </ScrollViewer>

            <!-- GSTR-3B: the four summary sections. -->
            <DataGrid ItemsSource="{Binding ThreeBSections}" MaxHeight="260"
                      Visibility="{Binding IsGstr3B, Converter={StaticResource BoolToVisibility}}"
                      AutoGenerateColumns="False" IsReadOnly="True" VerticalAlignment="Top"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="2*" />
                    <DataGridTextColumn Header="Taxable" Binding="{Binding TaxableValue, StringFormat=N2}" Width="SizeToCells" />
                    <DataGridTextColumn Header="IGST" Binding="{Binding Igst, StringFormat=N2}" Width="SizeToCells" />
                    <DataGridTextColumn Header="CGST" Binding="{Binding Cgst, StringFormat=N2}" Width="SizeToCells" />
                    <DataGridTextColumn Header="SGST" Binding="{Binding Sgst, StringFormat=N2}" Width="SizeToCells" />
                    <DataGridTextColumn Header="Cess" Binding="{Binding Cess, StringFormat=N2}" Width="SizeToCells" />
                    <DataGridTextColumn Header="Total tax" Binding="{Binding TotalTax, StringFormat=N2}" Width="SizeToCells" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- GSTR-9: monthly aggregation over the financial year so far. -->
            <DataGrid ItemsSource="{Binding NineMonthRows}" MaxHeight="360"
                      Visibility="{Binding IsGstr9, Converter={StaticResource BoolToVisibility}}"
                      AutoGenerateColumns="False" IsReadOnly="True" VerticalAlignment="Top"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Month" Binding="{Binding Period}" Width="SizeToCells" />
                    <DataGridTextColumn Header="Outward taxable" Binding="{Binding TaxableValue, StringFormat=N2}" Width="SizeToCells" />
                    <DataGridTextColumn Header="IGST" Binding="{Binding Igst, StringFormat=N2}" Width="SizeToCells" />
                    <DataGridTextColumn Header="CGST" Binding="{Binding Cgst, StringFormat=N2}" Width="SizeToCells" />
                    <DataGridTextColumn Header="SGST" Binding="{Binding Sgst, StringFormat=N2}" Width="SizeToCells" />
                    <DataGridTextColumn Header="Cess" Binding="{Binding Cess, StringFormat=N2}" Width="SizeToCells" />
                    <DataGridTextColumn Header="Net tax payable" Binding="{Binding NetTaxPayable, StringFormat=N2}" Width="SizeToCells" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <TextBlock Grid.Row="4" Margin="4,8,0,0" Text="{Binding Status}" Style="{StaticResource StatusText}" />
    </Grid>
</UserControl>
