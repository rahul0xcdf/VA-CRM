<UserControl x:Class="VinayakaAgencies.App.Views.Gstr2BReconciliationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="1020">

    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedResults" Source="{Binding Results}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Classification" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <!-- Report page (ADR-0006), grouped by classification. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="GSTR-2B reconciliation" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="portal file against posted purchase invoices, keyed by supplier GSTIN and invoice number"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Books from" Style="{StaticResource FieldLabel}" />
                <DatePicker Width="140" Margin="0,0,12,0" VerticalAlignment="Center"
                            SelectedDate="{Binding BooksFromDate}" />
                <TextBlock Text="to" Style="{StaticResource FieldLabel}" />
                <DatePicker Width="140" Margin="0,0,16,0" VerticalAlignment="Center"
                            SelectedDate="{Binding BooksToDate}" />
                <Button Content="Import &amp; reconcile" Style="{StaticResource BandButton}"
                        Command="{Binding ImportAndReconcileCommand}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource TotalsBandStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Matched" Style="{StaticResource TotalsLabelText}" />
                <TextBlock Text="{Binding MatchedSummary}" Style="{StaticResource TotalsValueText}" />

                <TextBlock Text="Missing in books" Style="{StaticResource TotalsLabelText}" />
                <TextBlock Text="{Binding MissingInBooksSummary}" Style="{StaticResource TotalsValueText}"
                           Foreground="{StaticResource WarningBrush}" />

                <TextBlock Text="Missing in portal" Style="{StaticResource TotalsLabelText}" />
                <TextBlock Text="{Binding MissingInPortalSummary}" Style="{StaticResource TotalsValueText}"
                           Foreground="{StaticResource WarningBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <DataGrid Style="{StaticResource PageGrid}"
                      ItemsSource="{Binding Source={StaticResource GroupedResults}}">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource HeaderRowBrush}" Padding="8,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="{Binding ItemCount, StringFormat={} · {0} line(s)}"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Supplier GSTIN" Binding="{Binding SupplierGstin}" Width="160" />
                    <DataGridTextColumn Header="Portal invoice" Binding="{Binding PortalInvoiceNumber}" Width="130" />
                    <DataGridTextColumn Header="Portal date" Binding="{Binding PortalInvoiceDate}" Width="110" />
                    <DataGridTextColumn Header="Portal value" Binding="{Binding PortalInvoiceValue, StringFormat=N2}" Width="120"
                                        ElementStyle="{StaticResource NumericCell}"
                                        HeaderStyle="{StaticResource NumericColumnHeader}" />
                    <DataGridTextColumn Header="Books invoice" Binding="{Binding BooksInvoiceNumber}" Width="130" />
                    <DataGridTextColumn Header="Books date" Binding="{Binding BooksInvoiceDate}" Width="110" />
                    <DataGridTextColumn Header="Books value" Binding="{Binding BooksInvoiceValue, StringFormat=N2}" Width="120"
                                        ElementStyle="{StaticResource NumericCell}"
                                        HeaderStyle="{StaticResource NumericColumnHeader}" />
                    <DataGridTextColumn Header="Mismatch details" Binding="{Binding MismatchDetails}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Style="{StaticResource EmptyStateText}"
                       Text="Nothing reconciled yet. Pick the period covered by your books and import the portal's GSTR-2B file."
                       Visibility="{Binding Results.Count, Converter={StaticResource ZeroToVisibility}}" />
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource PageStatusStyle}">
            <TextBlock Text="{Binding Status}" Style="{StaticResource PageStatusText}" />
        </Border>
    </Grid>
</UserControl>
