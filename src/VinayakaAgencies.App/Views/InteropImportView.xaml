<UserControl x:Class="VinayakaAgencies.App.Views.InteropImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="1020">

    <!--
        Two steps, because the import is two steps: Check reads the whole file and writes nothing,
        Ctrl+A commits it. The problem list is the largest thing on the page on purpose — it is what
        the owner works through on a migration (§4a D2).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Import" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="a Tally XML or JSON export, or a spreadsheet read through a saved column mapping — one problem stops the whole file"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Choose file (Alt+F)" Style="{StaticResource BandButton}"
                        Command="{Binding ChooseFileCommand}" />
                <TextBlock Text="{Binding FileName}" Style="{StaticResource FieldLabel}" Margin="12,0,0,0" />

                <CheckBox Content="Masters" Style="{StaticResource FieldCheck}" Margin="16,0,0,0"
                          IsChecked="{Binding ImportMasters}" />
                <CheckBox Content="Vouchers" Style="{StaticResource FieldCheck}"
                          IsChecked="{Binding ImportVouchers}" />

                <Button Content="Check" Style="{StaticResource BandButton}" Margin="16,0,0,0"
                        Command="{Binding CheckCommand}" />
                <Button Content="Import (Ctrl+A)" Style="{StaticResource BandButton}"
                        Command="{Binding CommitCommand}" IsEnabled="{Binding CanCommit}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource FilterBarStyle}"
                Visibility="{Binding IsWorkbook, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Column mapping" Style="{StaticResource FieldLabel}" />
                <ComboBox Width="280" Style="{StaticResource FieldCombo}"
                          ItemsSource="{Binding MappingChoices}"
                          SelectedItem="{Binding SelectedMapping}"
                          DisplayMemberPath="Name" />
                <TextBlock Text="a spreadsheet needs one, so the import knows which column is which"
                           Style="{StaticResource PageHintText}" Margin="12,0,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource TotalsBandStyle}">
            <ItemsControl ItemsSource="{Binding Tallies}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Kind}" Style="{StaticResource TotalsLabelText}" />
                            <TextBlock Style="{StaticResource TotalsValueText}">
                                <Run Text="{Binding Created, Mode=OneWay}" />
                                <Run Text="new," />
                                <Run Text="{Binding Updated, Mode=OneWay}" />
                                <Run Text="existing" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0" Style="{StaticResource PageGrid}" ItemsSource="{Binding Problems}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Where" Binding="{Binding Where}" Width="140" />
                    <DataGridTextColumn Header="Record" Binding="{Binding Kind}" Width="130" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Label}" Width="180" />
                    <DataGridTextColumn Header="Why it cannot be imported" Binding="{Binding Reason}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid Grid.Row="1" MaxHeight="150" Style="{StaticResource PageGrid}"
                      ItemsSource="{Binding Warnings}"
                      Visibility="{Binding Warnings.Count, Converter={StaticResource NonZeroToVisibility}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Where" Binding="{Binding Where}" Width="140" />
                    <DataGridTextColumn Header="Record" Binding="{Binding Kind}" Width="130" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Label}" Width="180" />
                    <DataGridTextColumn Header="Worth knowing — will still be imported"
                                        Binding="{Binding Reason}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="5" Style="{StaticResource DrillDownBandStyle}"
                Visibility="{Binding Reconciliation, Converter={StaticResource EmptyStringToVisibility}}">
            <StackPanel>
                <TextBlock Text="Reconciliation" Style="{StaticResource DrillDownHeadingText}" />
                <TextBlock Text="{Binding Reconciliation}" TextWrapping="Wrap"
                           Foreground="{StaticResource PrimaryTextBrush}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="6" Style="{StaticResource PageStatusStyle}">
            <DockPanel LastChildFill="True">
                <!--
                    Indeterminate while the file is being read, because how many records it holds is
                    not knowable until it has been. Hidden entirely when nothing is running, so the
                    status line does not carry a dead bar.
                -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding ProgressText, Converter={StaticResource EmptyStringToVisibility}}">
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource StatusHintText}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ProgressBar Width="160" Height="10" VerticalAlignment="Center"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}"
                                 Minimum="0" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}" />
                </StackPanel>

                <TextBlock Text="{Binding Status}" Style="{StaticResource PageStatusText}" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
