<UserControl x:Class="VinayakaAgencies.App.Views.ItemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <!-- Master-list page (ADR-0006). The entry band is two rows because an item genuinely has that
         many attributes; the kit row appears only for kit items. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Items" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="the catalogue everything stocks, moves and bills"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Filter" Style="{StaticResource FieldLabel}" />
                <TextBox Width="260" Style="{StaticResource FieldBox}"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Apply" Style="{StaticResource BandButton}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <DataGrid Style="{StaticResource PageGrid}"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="100" />
                    <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="120" />
                    <DataGridTextColumn Header="Group" Binding="{Binding StockGroupName}" Width="*" />
                    <DataGridTextColumn Header="Unit" Binding="{Binding BaseUnitCode}" Width="60" />
                    <DataGridCheckBoxColumn Header="Serials" Binding="{Binding IsSerialTracked}" Width="60" />
                    <DataGridCheckBoxColumn Header="Batches" Binding="{Binding IsBatchTracked}" Width="62" />
                    <DataGridCheckBoxColumn Header="Kit" Binding="{Binding IsKit}" Width="44" />
                    <DataGridTextColumn Header="Reorder at" Binding="{Binding ReorderLevel}" Width="86"
                                        ElementStyle="{StaticResource NumericCell}"
                                        HeaderStyle="{StaticResource NumericColumnHeader}" />
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="56" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Style="{StaticResource EmptyStateText}"
                       Text="No items match. Clear the filter, or create one below."
                       Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVisibility}}" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource EntryPanelStyle}">
            <StackPanel>
                <TextBlock Text="CREATE / ALTER" Style="{StaticResource EntryHeadingText}" />

                <!-- A WrapPanel, not a row: an item has more fields than fit on a laptop, and a
                     StackPanel clips the overflow silently — "Kit item" simply vanished off the
                     right edge. Wrapping keeps every field reachable at any window width. -->
                <WrapPanel>
                    <StackPanel Style="{StaticResource FieldPair}">
                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="190" Style="{StaticResource FieldBox}"
                                 Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource FieldPair}">
                        <TextBlock Text="Code" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="100" MinWidth="0" Style="{StaticResource FieldBox}" Text="{Binding EditCode}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource FieldPair}">
                        <TextBlock Text="Barcode" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="120" MinWidth="0" Style="{StaticResource FieldBox}" Text="{Binding EditBarcode}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource FieldPair}">
                        <TextBlock Text="Group" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="150" MinWidth="0" Style="{StaticResource FieldCombo}"
                                  ItemsSource="{Binding GroupChoices}"
                                  SelectedValue="{Binding EditStockGroupId}"
                                  SelectedValuePath="Id" DisplayMemberPath="Name" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource FieldPair}">
                        <TextBlock Text="Unit" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="80" MinWidth="0" Style="{StaticResource FieldCombo}"
                                  ItemsSource="{Binding UnitChoices}"
                                  SelectedValue="{Binding EditBaseUnitId}"
                                  SelectedValuePath="Id" DisplayMemberPath="Code" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource FieldPair}">
                        <TextBlock Text="Alt. unit" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="80" MinWidth="0" Style="{StaticResource FieldCombo}"
                                  ItemsSource="{Binding UnitChoices}"
                                  SelectedValue="{Binding EditAlternateUnitId}"
                                  SelectedValuePath="Id" DisplayMemberPath="Code" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource FieldPair}">
                        <TextBlock Text="× factor" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="70" MinWidth="0" Style="{StaticResource FieldBox}"
                                 Text="{Binding EditConversionFactor}" />
                    </StackPanel>

                    <CheckBox Content="Serial-tracked" Style="{StaticResource FieldCheck}"
                              IsChecked="{Binding EditIsSerialTracked}" />
                    <CheckBox Content="Batch-tracked" Style="{StaticResource FieldCheck}"
                              IsChecked="{Binding EditIsBatchTracked}" />

                    <StackPanel Style="{StaticResource FieldPair}">
                        <TextBlock Text="Valuation" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="150" MinWidth="0" Style="{StaticResource FieldCombo}"
                                  ItemsSource="{Binding ValuationChoices}"
                                  SelectedItem="{Binding EditValuationOverride}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ., TargetNullValue=Company default}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Style="{StaticResource FieldPair}">
                        <TextBlock Text="Reorder at" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="70" MinWidth="0" Style="{StaticResource FieldBox}"
                                 Text="{Binding EditReorderLevel}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource FieldPair}">
                        <TextBlock Text="HSN/SAC" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="130" MinWidth="0" Style="{StaticResource FieldCombo}"
                                  ItemsSource="{Binding HsnSacChoices}"
                                  SelectedValue="{Binding EditHsnSacId}"
                                  SelectedValuePath="Id" DisplayMemberPath="Code" />
                    </StackPanel>

                    <CheckBox Content="Kit item" Style="{StaticResource FieldCheck}"
                              IsChecked="{Binding EditIsKit}" />
                </WrapPanel>

                <!-- Kit components: only meaningful for kit items, so only shown for them. -->
                <StackPanel Margin="0,8,0,0"
                            Visibility="{Binding EditIsKit, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Component" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="250" Style="{StaticResource FieldCombo}"
                                  ItemsSource="{Binding ComponentChoices}"
                                  SelectedItem="{Binding NewComponentItem}" DisplayMemberPath="Name" />

                        <TextBlock Text="Qty per kit" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="70" MinWidth="0" Style="{StaticResource FieldBox}"
                                 Text="{Binding NewComponentQuantity, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Content="Add" Style="{StaticResource BandButton}"
                                Command="{Binding AddComponentCommand}" />
                        <Button Content="Remove" Style="{StaticResource BandButton}"
                                Command="{Binding RemoveComponentCommand}" />
                        <Button Content="Save components" Style="{StaticResource BandButton}"
                                Command="{Binding SaveComponentsCommand}" />
                    </StackPanel>

                    <ListBox Height="66" Margin="0,7,0,0" Width="460" HorizontalAlignment="Left"
                             ItemsSource="{Binding KitComponents}"
                             SelectedItem="{Binding SelectedComponent}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                    <Button Content="New" Style="{StaticResource BandButton}" Command="{Binding NewCommand}" />
                    <Button Content="Save" Style="{StaticResource BandButton}" Command="{Binding SaveCommand}" />
                    <Border Width="1" Margin="4,2,12,2" Background="{StaticResource ControlBorderBrush}" />
                    <Button Content="Deactivate" Style="{StaticResource BandButton}"
                            Command="{Binding DeactivateSelectedCommand}" />
                    <Button Content="Delete" Style="{StaticResource BandButton}"
                            ToolTip="Allowed only for an item that has never moved in the stock ledger."
                            Command="{Binding DeleteSelectedCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource PageStatusStyle}">
            <TextBlock Text="{Binding Status}" Style="{StaticResource PageStatusText}" />
        </Border>
    </Grid>
</UserControl>
