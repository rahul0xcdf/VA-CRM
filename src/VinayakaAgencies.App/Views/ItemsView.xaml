<UserControl x:Class="VinayakaAgencies.App.Views.ItemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Items — the catalogue everything stocks, moves and bills"
                   Style="{StaticResource ScreenTitleText}" />

        <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,10,0,8">
            <TextBlock Text="Filter:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBox Width="220" Margin="6,0,16,0"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Refresh / apply filter" Padding="14,5" Command="{Binding RefreshCommand}" />
        </DockPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="SizeToCells" />
                <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="SizeToCells" />
                <DataGridTextColumn Header="Group" Binding="{Binding StockGroupName}" Width="*" />
                <DataGridTextColumn Header="Unit" Binding="{Binding BaseUnitCode}" Width="SizeToHeader" />
                <DataGridCheckBoxColumn Header="Serials" Binding="{Binding IsSerialTracked}" Width="SizeToHeader" />
                <DataGridCheckBoxColumn Header="Batches" Binding="{Binding IsBatchTracked}" Width="SizeToHeader" />
                <DataGridCheckBoxColumn Header="Kit" Binding="{Binding IsKit}" Width="SizeToHeader" />
                <DataGridTextColumn Header="Reorder at" Binding="{Binding ReorderLevel}" Width="SizeToHeader" />
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="SizeToHeader" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" Padding="12" Margin="0,12,0,0" CornerRadius="6"
                BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Name:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Width="180" Margin="6,0,12,0"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Code:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Width="90" Margin="6,0,12,0" Text="{Binding EditCode}" />
                    <TextBlock Text="Barcode:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Width="110" Margin="6,0,12,0" Text="{Binding EditBarcode}" />
                    <TextBlock Text="Group:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <ComboBox Width="130" Margin="6,0,12,0"
                              ItemsSource="{Binding GroupChoices}"
                              SelectedValue="{Binding EditStockGroupId}"
                              SelectedValuePath="Id" DisplayMemberPath="Name" />
                    <TextBlock Text="Base unit:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <ComboBox Width="80" Margin="6,0,12,0"
                              ItemsSource="{Binding UnitChoices}"
                              SelectedValue="{Binding EditBaseUnitId}"
                              SelectedValuePath="Id" DisplayMemberPath="Code" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Alt. unit:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <ComboBox Width="80" Margin="6,0,12,0"
                              ItemsSource="{Binding UnitChoices}"
                              SelectedValue="{Binding EditAlternateUnitId}"
                              SelectedValuePath="Id" DisplayMemberPath="Code" />
                    <TextBlock Text="× factor:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Width="70" Margin="6,0,16,0" Text="{Binding EditConversionFactor}" />
                    <CheckBox Content="Serial-tracked" VerticalAlignment="Center" Margin="0,0,12,0"
                              IsChecked="{Binding EditIsSerialTracked}" />
                    <CheckBox Content="Batch-tracked" VerticalAlignment="Center" Margin="0,0,12,0"
                              IsChecked="{Binding EditIsBatchTracked}" />
                    <TextBlock Text="Valuation:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <ComboBox Width="140" Margin="6,0,12,0"
                              ItemsSource="{Binding ValuationChoices}"
                              SelectedItem="{Binding EditValuationOverride}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ., TargetNullValue=Company default}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Reorder at:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Width="60" Margin="6,0,16,0" Text="{Binding EditReorderLevel}" />
                    <TextBlock Text="HSN/SAC:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <ComboBox Width="130" Margin="6,0,12,0"
                              ItemsSource="{Binding HsnSacChoices}"
                              SelectedValue="{Binding EditHsnSacId}"
                              SelectedValuePath="Id" DisplayMemberPath="Code" />
                    <CheckBox Content="Kit item" VerticalAlignment="Center"
                              IsChecked="{Binding EditIsKit}" />
                </StackPanel>

                <!-- Kit components: only meaningful for saved kit items. -->
                <StackPanel Margin="0,8,0,0"
                            Visibility="{Binding EditIsKit, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Component:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox Width="240" Margin="6,0,12,0"
                                  ItemsSource="{Binding ComponentChoices}"
                                  SelectedItem="{Binding NewComponentItem}"
                                  DisplayMemberPath="Name" />
                        <TextBlock Text="Qty per kit:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox Width="60" Margin="6,0,12,0"
                                 Text="{Binding NewComponentQuantity, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Add component" Padding="14,5" Command="{Binding AddComponentCommand}" />
                        <Button Content="Remove selected" Margin="8,0,0,0" Padding="14,5"
                                Command="{Binding RemoveComponentCommand}" />
                        <Button Content="Save components" Margin="8,0,0,0" Padding="14,5"
                                Command="{Binding SaveComponentsCommand}" />
                    </StackPanel>
                    <ListBox Height="72" Margin="6,8,0,0" Width="420" HorizontalAlignment="Left"
                             ItemsSource="{Binding KitComponents}"
                             SelectedItem="{Binding SelectedComponent}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="New" Padding="14,5" Command="{Binding NewCommand}" />
                    <Button Content="Save item" Margin="8,0,0,0" Padding="14,5"
                            Command="{Binding SaveCommand}" />
                    <Button Content="Deactivate" Margin="8,0,0,0" Padding="14,5"
                            Command="{Binding DeactivateSelectedCommand}" />
                    <Button Content="Delete (only if never moved)" Margin="8,0,0,0" Padding="14,5"
                            Command="{Binding DeleteSelectedCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="4" LastChildFill="False">
            <TextBlock DockPanel.Dock="Right" Margin="0,12,0,0"
                       Text="{Binding Status}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</UserControl>
