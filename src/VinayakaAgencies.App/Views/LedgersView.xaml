<UserControl x:Class="VinayakaAgencies.App.Views.LedgersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="900">

    <!-- Master-list page (ADR-0006): header, filter band, grid, entry band, status. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Ledgers" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="grouped by account group, searchable by name or alias"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Group" Style="{StaticResource FieldLabel}" />
                <ComboBox Width="190" Style="{StaticResource FieldCombo}"
                          ItemsSource="{Binding GroupChoices}"
                          SelectedItem="{Binding GroupFilter}" DisplayMemberPath="Name" />

                <TextBlock Text="Search" Style="{StaticResource FieldLabel}" />
                <TextBox Width="220" Style="{StaticResource FieldBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Content="Show inactive" Style="{StaticResource FieldCheck}"
                          IsChecked="{Binding IncludeInactive}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <DataGrid Style="{StaticResource PageGrid}"
                      ItemsSource="{Binding VisibleLedgers}"
                      SelectedItem="{Binding SelectedLedger}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Alias" Binding="{Binding Alias}" Width="120" />
                    <DataGridTextColumn Header="Group" Binding="{Binding AccountGroupName}" Width="*" />
                    <DataGridCheckBoxColumn Header="System" Binding="{Binding IsSystem}" Width="70" />
                    <DataGridCheckBoxColumn Header="Manual posting" Binding="{Binding AllowsManualPosting}" Width="110" />
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Shown only when the filter matches nothing, so an empty page explains itself. -->
            <TextBlock Style="{StaticResource EmptyStateText}"
                       Text="No ledger matches this filter. Clear the search, or create one below."
                       Visibility="{Binding VisibleLedgers.Count,
                           Converter={StaticResource ZeroToVisibility}}" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource EntryPanelStyle}">
            <StackPanel>
                <TextBlock Text="CREATE / ALTER" Style="{StaticResource EntryHeadingText}" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="220" Style="{StaticResource FieldBox}"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Group" Style="{StaticResource FieldLabel}" />
                    <ComboBox Width="190" Style="{StaticResource FieldCombo}"
                              ItemsSource="{Binding GroupChoices}"
                              SelectedValue="{Binding EditGroupId}"
                              SelectedValuePath="Id" DisplayMemberPath="Name" />

                    <TextBlock Text="Alias" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="120" Style="{StaticResource FieldBox}" Text="{Binding EditAlias}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                    <Button Content="New" Style="{StaticResource BandButton}"
                            Command="{Binding NewLedgerCommand}" />
                    <Button Content="Save" Style="{StaticResource BandButton}"
                            Command="{Binding SaveLedgerCommand}" />
                    <Border Width="1" Margin="4,2,12,2" Background="{StaticResource ControlBorderBrush}" />
                    <Button Content="Deactivate" Style="{StaticResource BandButton}"
                            Command="{Binding DeactivateSelectedCommand}" />
                    <Button Content="Reactivate" Style="{StaticResource BandButton}"
                            Command="{Binding ActivateSelectedCommand}" />
                    <Button Content="Delete" Style="{StaticResource BandButton}"
                            ToolTip="Allowed only for a ledger that has never been posted to."
                            Command="{Binding DeleteSelectedCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource PageStatusStyle}">
            <TextBlock Text="{Binding Status}" Style="{StaticResource PageStatusText}" />
        </Border>
    </Grid>
</UserControl>
