<Window x:Class="VinayakaAgencies.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VinayakaAgencies.App.Presentation.Controls"
        Title="Sign in"
        Width="520" Height="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Vinayaka Agencies" Style="{StaticResource ScreenTitleText}" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Every change to the books is recorded against the person who made it, so the books open under a name rather than a machine." />
        </StackPanel>

        <!-- Sign in: the ordinary case. -->
        <Grid Grid.Row="1" Margin="0,20,0,0"
              Visibility="{Binding ShowSignIn, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="User name:" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4"
                     Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Password:" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <PasswordBox Grid.Row="1" Grid.Column="1" Margin="0,4"
                         controls:PasswordBoxBinding.BoundPassword="{Binding Password, Mode=TwoWay}" />
        </Grid>

        <!-- First launch: create the owner account. No account is ever seeded. -->
        <Grid Grid.Row="1" Margin="0,20,0,0"
              Visibility="{Binding IsFirstAccount, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="User name:" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4"
                     Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Your name:" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4"
                     Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Password:" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <PasswordBox Grid.Row="2" Grid.Column="1" Margin="0,4"
                         controls:PasswordBoxBinding.BoundPassword="{Binding NewPassword, Mode=TwoWay}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Again:" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <PasswordBox Grid.Row="3" Grid.Column="1" Margin="0,4"
                         controls:PasswordBoxBinding.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay}" />
        </Grid>

        <!-- Signed in under a password the owner chose. -->
        <Grid Grid.Row="1" Margin="0,20,0,0"
              Visibility="{Binding MustChangePassword, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Current:" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <PasswordBox Grid.Row="0" Grid.Column="1" Margin="0,4"
                         controls:PasswordBoxBinding.BoundPassword="{Binding Password, Mode=TwoWay}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="New password:" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <PasswordBox Grid.Row="1" Grid.Column="1" Margin="0,4"
                         controls:PasswordBoxBinding.BoundPassword="{Binding NewPassword, Mode=TwoWay}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Again:" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <PasswordBox Grid.Row="2" Grid.Column="1" Margin="0,4"
                         controls:PasswordBoxBinding.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay}" />
        </Grid>

        <StackPanel Grid.Row="2">
            <StackPanel Orientation="Horizontal">
                <Button Content="Sign in" Padding="18,7" IsDefault="True"
                        Command="{Binding SignInCommand}"
                        Visibility="{Binding ShowSignIn, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Create owner account &amp; open books" Padding="18,7"
                        Command="{Binding CreateFirstAccountCommand}"
                        Visibility="{Binding IsFirstAccount, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Change password &amp; continue" Padding="18,7"
                        Command="{Binding ChangePasswordCommand}"
                        Visibility="{Binding MustChangePassword, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Quit" Margin="12,0,0,0" Padding="18,7"
                        IsCancel="True"
                        Command="{Binding QuitCommand}" />
            </StackPanel>

            <TextBlock Margin="2,10,0,0" Text="{Binding Status}" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
    </Grid>
</Window>
