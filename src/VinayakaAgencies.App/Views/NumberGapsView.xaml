<UserControl x:Class="VinayakaAgencies.App.Views.NumberGapsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="760">

    <!-- Report page (ADR-0006). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Voucher-number gaps" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="reported, never backfilled (decision D2, spec 8.7)"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Load lists" Style="{StaticResource BandButton}"
                        Command="{Binding LoadListsCommand}" />

                <TextBlock Text="Series" Style="{StaticResource FieldLabel}" />
                <ComboBox Width="170" Style="{StaticResource FieldCombo}"
                          ItemsSource="{Binding SeriesChoices}"
                          SelectedItem="{Binding SelectedSeries}" DisplayMemberPath="Name" />

                <TextBlock Text="Year" Style="{StaticResource FieldLabel}" />
                <ComboBox Width="140" Style="{StaticResource FieldCombo}"
                          ItemsSource="{Binding YearsOnRecord}"
                          SelectedItem="{Binding SelectedYear}" DisplayMemberPath="Label" />

                <Button Content="Show gaps" Style="{StaticResource BandButton}"
                        Command="{Binding ShowGapsCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <DataGrid Style="{StaticResource PageGrid}" ItemsSource="{Binding Gaps}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Missing number" Binding="{Binding MissingNumber}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- No gaps is the good outcome, so it is stated rather than shown as an empty table. -->
            <TextBlock Style="{StaticResource EmptyStateText}"
                       Text="No gaps in this series and year. Every number allocated has a voucher against it."
                       Visibility="{Binding Gaps.Count, Converter={StaticResource ZeroToVisibility}}" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource PageStatusStyle}">
            <TextBlock Text="{Binding Status}" Style="{StaticResource PageStatusText}" />
        </Border>
    </Grid>
</UserControl>
