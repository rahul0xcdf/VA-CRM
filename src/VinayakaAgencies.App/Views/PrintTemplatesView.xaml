<UserControl x:Class="VinayakaAgencies.App.Views.PrintTemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200">

    <!-- Master-list page with a side editor (ADR-0006): the template list and its version history on
         the left, the layout fields on the right. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Print templates" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="edit what your documents look like; no rebuild needed"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Kind" Style="{StaticResource FieldLabel}" />
                <ComboBox Width="170" Style="{StaticResource FieldCombo}"
                          ItemsSource="{Binding KindChoices}" SelectedItem="{Binding KindFilter}" />

                <Button Content="Refresh" Style="{StaticResource BandButton}"
                        Command="{Binding RefreshCommand}" />
                <Button Content="Load selected" Style="{StaticResource BandButton}"
                        Command="{Binding LoadSelectedCommand}" />
                <Button Content="Save as new version" Style="{StaticResource BandButton}"
                        Command="{Binding SaveLayoutCommand}" />
                <Button Content="Activate / retire" Style="{StaticResource BandButton}"
                        Command="{Binding ToggleSelectedActiveCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="200" />
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" Style="{StaticResource PageGrid}"
                          ItemsSource="{Binding Templates}"
                          SelectedItem="{Binding SelectedTemplate}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kind" Binding="{Binding DocumentKind}" Width="110" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="60"
                                            ElementStyle="{StaticResource NumericCell}"
                                            HeaderStyle="{StaticResource NumericColumnHeader}" />
                        <DataGridTextColumn Header="Ver" Binding="{Binding CurrentVersion}" Width="46"
                                            ElementStyle="{StaticResource NumericCell}"
                                            HeaderStyle="{StaticResource NumericColumnHeader}" />
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="56" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1" Style="{StaticResource TotalsBandStyle}">
                    <TextBlock Text="VERSION HISTORY" Style="{StaticResource EntryHeadingText}" Margin="0" />
                </Border>

                <DataGrid Grid.Row="2" Style="{StaticResource PageGrid}" ItemsSource="{Binding Revisions}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="70"
                                            ElementStyle="{StaticResource NumericCell}"
                                            HeaderStyle="{StaticResource NumericColumnHeader}" />
                        <DataGridTextColumn Header="Saved at" Binding="{Binding CreatedAtUtc}" Width="*" />
                        <DataGridTextColumn Header="By" Binding="{Binding CreatedBy}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Border Grid.Column="1" Width="1" Background="{StaticResource ControlBorderBrush}" />

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,12,16,12" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Text="LAYOUT" Style="{StaticResource EntryHeadingText}" />

                    <TextBlock Text="Title" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox Content="Print the company logo" IsChecked="{Binding ShowLogo}" Margin="0,12,0,3" />
                    <TextBlock Text="Logo image path (when shown)" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                    <TextBox Text="{Binding LogoPath, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Header lines (one per line)" Style="{StaticResource FieldLabel}" Margin="0,12,0,3" />
                    <TextBox Height="64" AcceptsReturn="True" TextWrapping="Wrap"
                             Text="{Binding HeaderLines, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Footer note" Style="{StaticResource FieldLabel}" Margin="0,12,0,3" />
                    <TextBox Text="{Binding FooterNote, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Terms &amp; conditions" Style="{StaticResource FieldLabel}" Margin="0,12,0,3" />
                    <TextBox Height="72" AcceptsReturn="True" TextWrapping="Wrap"
                             Text="{Binding TermsAndConditions, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Visible columns" Style="{StaticResource FieldLabel}" Margin="0,12,0,3" />
                    <WrapPanel>
                        <CheckBox Content="Sr" IsChecked="{Binding ColumnSr}" Margin="0,2,16,2" />
                        <CheckBox Content="Item" IsChecked="{Binding ColumnItem}" Margin="0,2,16,2" />
                        <CheckBox Content="Qty" IsChecked="{Binding ColumnQty}" Margin="0,2,16,2" />
                        <CheckBox Content="Rate" IsChecked="{Binding ColumnRate}" Margin="0,2,16,2" />
                        <CheckBox Content="Discount" IsChecked="{Binding ColumnDiscount}" Margin="0,2,16,2" />
                        <CheckBox Content="Amount" IsChecked="{Binding ColumnAmount}" Margin="0,2,16,2" />
                    </WrapPanel>

                    <TextBlock Text="Copy labels — semicolon separated, one printed page each"
                               Style="{StaticResource FieldLabel}" Margin="0,12,0,3" />
                    <TextBox Text="{Binding CopyLabels, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource PageStatusStyle}">
            <TextBlock Text="{Binding Status}" Style="{StaticResource PageStatusText}" />
        </Border>
    </Grid>
</UserControl>
