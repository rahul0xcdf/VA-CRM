<UserControl x:Class="VinayakaAgencies.App.Views.PrintTemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Print templates â€” edit what your documents look like, no rebuild needed"
                   Style="{StaticResource ScreenTitleText}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,8">
            <TextBlock Text="Kind:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
            <ComboBox Width="150" Margin="6,0,16,0"
                      ItemsSource="{Binding KindChoices}"
                      SelectedItem="{Binding KindFilter}" />
            <Button Content="Refresh" Padding="14,5" Command="{Binding RefreshCommand}" />
            <Button Content="Load selected" Margin="8,0,0,0" Padding="14,5"
                    Command="{Binding LoadSelectedCommand}" />
            <Button Content="Save as new version" Margin="8,0,0,0" Padding="14,5"
                    Command="{Binding SaveLayoutCommand}" />
            <Button Content="Activate / retire" Margin="8,0,0,0" Padding="14,5"
                    Command="{Binding ToggleSelectedActiveCommand}" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock DockPanel.Dock="Bottom" Text="Version history" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" Margin="2,8,0,4" />
                <DataGrid DockPanel.Dock="Top" Height="180"
                          ItemsSource="{Binding Templates}"
                          SelectedItem="{Binding SelectedTemplate}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kind" Binding="{Binding DocumentKind}" Width="110" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="60" />
                        <DataGridTextColumn Header="Ver" Binding="{Binding CurrentVersion}" Width="45" />
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid ItemsSource="{Binding Revisions}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="70" />
                        <DataGridTextColumn Header="Saved at" Binding="{Binding CreatedAtUtc}" Width="*" />
                        <DataGridTextColumn Header="By" Binding="{Binding CreatedBy}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="Title" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox Content="Print the company logo" IsChecked="{Binding ShowLogo}" Margin="0,10,0,2" />
                    <TextBlock Text="Logo image path (when shown)" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Text="{Binding LogoPath, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,10,0,2" Text="Header lines (one per line)" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Height="64" AcceptsReturn="True"
                             Text="{Binding HeaderLines, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,10,0,2" Text="Footer note" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Text="{Binding FooterNote, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,10,0,2" Text="Terms &amp; conditions" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Height="72" AcceptsReturn="True"
                             Text="{Binding TermsAndConditions, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,10,0,2" Text="Visible columns" Foreground="{StaticResource SecondaryTextBrush}" />
                    <WrapPanel>
                        <CheckBox Content="Sr" IsChecked="{Binding ColumnSr}" Margin="0,2,14,2" />
                        <CheckBox Content="Item" IsChecked="{Binding ColumnItem}" Margin="0,2,14,2" />
                        <CheckBox Content="Qty" IsChecked="{Binding ColumnQty}" Margin="0,2,14,2" />
                        <CheckBox Content="Rate" IsChecked="{Binding ColumnRate}" Margin="0,2,14,2" />
                        <CheckBox Content="Discount" IsChecked="{Binding ColumnDiscount}" Margin="0,2,14,2" />
                        <CheckBox Content="Amount" IsChecked="{Binding ColumnAmount}" Margin="0,2,14,2" />
                    </WrapPanel>

                    <TextBlock Margin="0,10,0,2"
                               Text="Copy labels (; separated â€” one printed page each)"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Text="{Binding CopyLabels, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="3" Margin="4,8,0,0" Text="{Binding Status}" Foreground="{StaticResource SecondaryTextBrush}"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
