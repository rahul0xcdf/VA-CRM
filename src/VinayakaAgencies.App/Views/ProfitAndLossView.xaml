<UserControl x:Class="VinayakaAgencies.App.Views.ProfitAndLossView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="900">

    <!-- Two-column report page (ADR-0006). The halves are divided by a hairline rather than a gap, so
         the two grids read as one statement instead of two unrelated tables. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Profit &amp; loss" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="the gross block above the line, indirect items below it"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="From" Style="{StaticResource FieldLabel}" />
                <DatePicker Width="140" Margin="0,0,16,0" VerticalAlignment="Center"
                            SelectedDate="{Binding FromDate}" />
                <TextBlock Text="To" Style="{StaticResource FieldLabel}" />
                <DatePicker Width="140" Margin="0,0,16,0" VerticalAlignment="Center"
                            SelectedDate="{Binding ToDate}" />
                <Button Content="Load" Style="{StaticResource BandButton}" Command="{Binding LoadCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" Style="{StaticResource PageGrid}" ItemsSource="{Binding GrossRows}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Trading ledger" Binding="{Binding LedgerName}" Width="2*" />
                    <DataGridTextColumn Header="Group" Binding="{Binding AccountGroupName}" Width="*" />
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="130"
                                        ElementStyle="{StaticResource NumericCell}"
                                        HeaderStyle="{StaticResource NumericColumnHeader}" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Width="1" Background="{StaticResource ControlBorderBrush}" />

            <DataGrid Grid.Column="2" Style="{StaticResource PageGrid}" ItemsSource="{Binding IndirectRows}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Indirect ledger" Binding="{Binding LedgerName}" Width="2*" />
                    <DataGridTextColumn Header="Group" Binding="{Binding AccountGroupName}" Width="*" />
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="130"
                                        ElementStyle="{StaticResource NumericCell}"
                                        HeaderStyle="{StaticResource NumericColumnHeader}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource TotalsBandStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Income" Style="{StaticResource TotalsLabelText}" />
                <TextBlock Text="{Binding TotalIncome, StringFormat=N2}" Style="{StaticResource TotalsValueText}" />
                <TextBlock Text="Expense" Style="{StaticResource TotalsLabelText}" />
                <TextBlock Text="{Binding TotalExpense, StringFormat=N2}" Style="{StaticResource TotalsValueText}" />
                <TextBlock Text="Gross profit" Style="{StaticResource TotalsLabelText}" />
                <TextBlock Text="{Binding GrossProfit, StringFormat=N2}" Style="{StaticResource TotalsValueText}" />
                <TextBlock Text="Net profit" Style="{StaticResource TotalsLabelText}" />
                <TextBlock Text="{Binding NetProfit, StringFormat=N2}" FontSize="14"
                           Style="{StaticResource TotalsValueText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource PageStatusStyle}">
            <TextBlock Text="{Binding Status}" Style="{StaticResource PageStatusText}" />
        </Border>
    </Grid>
</UserControl>
