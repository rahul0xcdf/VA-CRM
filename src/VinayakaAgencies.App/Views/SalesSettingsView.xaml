<UserControl x:Class="VinayakaAgencies.App.Views.SalesSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="900">

    <!-- Settings page (ADR-0006): one band per setting, each with the consequence spelled out
         underneath it rather than in one paragraph covering everything. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Sales settings" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="pricing overrides and credit policy"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource SettingsSectionStyle}">
                    <StackPanel>
                        <TextBlock Text="PRICE OVERRIDES" Style="{StaticResource EntryHeadingText}" />
                        <CheckBox Content="Allow price overrides on sale documents"
                                  IsChecked="{Binding AllowPriceOverride}" />
                        <TextBlock Style="{StaticResource SettingsCaptionText}"
                                   Text="With this off, a sale line keeps the price the engine applied: the rate cell locks, and every other path refuses the change too. Every override that is exercised is written to the edit log alongside the price it replaced." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsSectionStyle}">
                    <StackPanel>
                        <TextBlock Text="CREDIT LIMIT" Style="{StaticResource EntryHeadingText}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Policy" Style="{StaticResource FieldLabel}" />
                            <ComboBox Width="140" Style="{StaticResource FieldCombo}"
                                      ItemsSource="{Binding PolicyChoices}"
                                      SelectedItem="{Binding CreditLimitPolicy}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SettingsCaptionText}"
                                   Text="Warn lets a sale cross the customer's credit limit once it has been confirmed. Block refuses it outright." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource EntryPanelStyle}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Save settings" Style="{StaticResource BandButton}" Command="{Binding SaveCommand}" />
                <Button Content="Reload" Style="{StaticResource BandButton}" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource PageStatusStyle}">
            <TextBlock Text="{Binding Status}" Style="{StaticResource PageStatusText}" />
        </Border>
    </Grid>
</UserControl>
