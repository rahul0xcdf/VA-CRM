<UserControl x:Class="VinayakaAgencies.App.Views.SalesSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="900">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Sales settings â€” pricing overrides and credit policy"
                   Style="{StaticResource ScreenTitleText}" />

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" Padding="12" Margin="0,10,0,0" CornerRadius="6"
                BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="Allow price overrides on sale documents"
                              VerticalAlignment="Center"
                              IsChecked="{Binding AllowPriceOverride}" />
                    <TextBlock Text="Credit limit policy:" VerticalAlignment="Center" Margin="24,0,6,0"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <ComboBox Width="120"
                              ItemsSource="{Binding PolicyChoices}"
                              SelectedItem="{Binding CreditLimitPolicy}" />
                </StackPanel>

                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"
                           Text="When overrides are off, sale lines keep the price the engine applied â€” the rate cell locks and every other path refuses too. Every override exercised is written to the edit log with its original value. 'Warn' lets a sale cross the customer's credit limit after confirmation; 'Block' refuses it outright." />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Save settings" Padding="14,5" Command="{Binding SaveCommand}" />
                    <Button Content="Reload" Margin="8,0,0,0" Padding="14,5"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="3" LastChildFill="False">
            <TextBlock DockPanel.Dock="Right" Margin="0,12,0,0"
                       Text="{Binding Status}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</UserControl>
