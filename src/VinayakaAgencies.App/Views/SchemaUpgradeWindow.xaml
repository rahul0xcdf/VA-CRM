<Window x:Class="VinayakaAgencies.App.Views.SchemaUpgradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Database upgrade required"
        Width="600" Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}">

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="This database needs upgrading"
                       Style="{StaticResource ScreenTitleText}" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Apply this from one machine only, with every other counter closed. Two clients upgrading the same database at once can damage it, which is why this is no longer done automatically." />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,0" Padding="12"
                BorderThickness="1"
                BorderBrush="{StaticResource BorderBrush}">
            <ListBox ItemsSource="{Binding PendingMigrations}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </Border>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Apply upgrade now"
                        Padding="18,7"
                        Command="{Binding ApplyCommand}" />
/>
                <Button Content="Close without upgrading"
                        Margin="12,0,0,0"
                        Padding="18,7"
                        Command="{Binding QuitCommand}"
/>
            </StackPanel>

            <TextBlock Margin="2,10,0,0" Text="{Binding Status}" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
    </Grid>
</Window>
