<Window x:Class="VinayakaAgencies.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VinayakaAgencies.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="{Binding Title}"
        Height="680" Width="1120"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceAltBrush}">

    <!-- ADR-0005 shell: top header (company, GSTIN, financial year), left home menu of numbered
         modules, content host, bottom status bar (mode · period · shortcut hints). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding CompanyLegalName}"
                               Style="{StaticResource ScreenTitleText}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Style="{StaticResource StatusHintText}"
                                   Text="{Binding CompanyGstin, StringFormat=GSTIN: {0}}" />
                        <TextBlock Style="{StaticResource StatusHintText}" Margin="12,0,0,0"
                                   Text="{Binding ActivePeriod}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                           FontSize="{StaticResource FontSize.Title}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           Text="{Binding Title}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource MenuBackgroundBrush}">
                <ListBox ItemsSource="{Binding Screens}"
                         SelectedItem="{Binding SelectedScreen}"
                         Style="{StaticResource HomeMenuListStyle}"
                         ItemContainerStyle="{StaticResource HomeMenuItemContainerStyle}"
                         Margin="6,10">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               Margin="4,8,0,2"
                                               FontSize="{StaticResource FontSize.Caption}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" MinWidth="180">
                                <TextBlock Text="{Binding ScreenKey}" Width="18"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding Screen.Header}"
                                           FontSize="{StaticResource FontSize.BodyLarge}"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding ActiveView}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource StatusBarBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource StatusHintText}"
                           FontWeight="SemiBold"
                           Text="{Binding CurrentMode}" />
                <TextBlock Grid.Column="1" Style="{StaticResource StatusHintText}"
                           HorizontalAlignment="Center"
                           Text="{Binding ActivePeriod}" />
                <TextBlock Grid.Column="2" Style="{StaticResource StatusHintText}"
                           Text="{Binding ShortcutHints}" />
            </Grid>
        </Border>
    </Grid>
</Window>
