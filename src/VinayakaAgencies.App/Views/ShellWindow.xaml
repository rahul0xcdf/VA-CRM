<Window x:Class="VinayakaAgencies.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VinayakaAgencies.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="{Binding Title}"
        Height="640" Width="1040"
        WindowStartupLocation="CenterScreen"
        Background="#FFF4F6F9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Brand green to blue, sampled from Assets\logo.png (#38AE71 / #1B7EB7). -->
        <Border Grid.Row="0" Padding="24,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF38AE71" Offset="0.0" />
                    <GradientStop Color="#FF1B7EB7" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel>
                <TextBlock Text="{Binding Title}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="White" />
                <TextBlock Text="{Binding Tagline}"
                           Margin="0,2,0,0"
                           FontSize="11"
                           Foreground="#CCFFFFFF" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FFEDF1F6">
                <ListBox ItemsSource="{Binding Screens}"
                         SelectedItem="{Binding SelectedScreen}"
                         BorderThickness="0"
                         Background="Transparent"
                         Margin="8,12"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6,4" MinWidth="180">
                                <TextBlock Text="{Binding Group}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#FF7A8AA3" />
                                <TextBlock Text="{Binding Screen.Header}"
                                           FontSize="13"
                                           Margin="0,2,0,0"
                                           Foreground="#FF12314F" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding ActiveView}" />
        </Grid>

        <Border Grid.Row="2" Background="#FFEDF1F6" Padding="24,8">
            <TextBlock Text="Vinayaka Agencies — accounting, billing and inventory"
                       FontSize="11" Foreground="#FF5A6B85" />
        </Border>
    </Grid>
</Window>
