<UserControl x:Class="VinayakaAgencies.App.Views.StockReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="1000">

    <!-- Report page (ADR-0006). Columns are generated because the shape changes with the report
         chosen; the density still comes from the shared DataGrid style. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Stock reports" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="on hand, valuation, reorder alerts and aging"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Report" Style="{StaticResource FieldLabel}" />
                <ComboBox Width="280" Style="{StaticResource FieldCombo}"
                          ItemsSource="{Binding ReportChoices}"
                          SelectedItem="{Binding SelectedReport}" />

                <TextBlock Text="As of" Style="{StaticResource FieldLabel}" />
                <DatePicker Width="140" Margin="0,0,16,0" VerticalAlignment="Center"
                            SelectedDate="{Binding AsOfDate}" />

                <Button Content="Run report" Style="{StaticResource BandButton}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Border>

        <!-- The C2.1 reconciliation banner: only shown for the report that computes it. -->
        <Border Grid.Row="2" Style="{StaticResource TotalsBandStyle}"
                Visibility="{Binding ReconciliationBannerVisibility}">
            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" />
        </Border>

        <DataGrid Grid.Row="3" Style="{StaticResource PageGrid}"
                  AutoGenerateColumns="True"
                  ItemsSource="{Binding Rows}" />

        <Border Grid.Row="4" Style="{StaticResource PageStatusStyle}">
            <TextBlock Text="{Binding Status}" Style="{StaticResource PageStatusText}" />
        </Border>
    </Grid>
</UserControl>
