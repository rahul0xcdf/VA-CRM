<UserControl x:Class="VinayakaAgencies.App.Views.StockVoucherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Stock vouchers — opening balances, receipts, issues and transfers"
                   Style="{StaticResource ScreenTitleText}" />

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" Padding="12" Margin="0,10,0,8" CornerRadius="6"
                BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Purpose:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <ComboBox Width="140" Margin="6,0,16,0"
                              ItemsSource="{Binding PurposeChoices}"
                              SelectedItem="{Binding Purpose}" />
                    <TextBlock Text="Date:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <DatePicker Width="130" Margin="6,0,16,0" SelectedDate="{Binding VoucherDate}" />
                    <TextBlock Text="Counter ledger:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <ComboBox Width="220" Margin="6,0,16,0"
                              ItemsSource="{Binding LedgerChoices}"
                              SelectedItem="{Binding CounterLedger}"
                              DisplayMemberPath="Name" />
                    <TextBlock Text="Narration:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Width="260" Margin="6,0,0,0"
                             Text="{Binding Narration, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Find item:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Width="200" Margin="6,0,6,0"
                             Text="{Binding ItemSearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Search" Padding="14,5" Command="{Binding SearchItemsCommand}" />
                    <ComboBox Width="240" Margin="8,0,16,0"
                              ItemsSource="{Binding ItemChoices}"
                              SelectedItem="{Binding SelectedNewItem}"
                              DisplayMemberPath="Name" />
                    <TextBlock Text="Default godown:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <ComboBox Width="150" Margin="6,0,0,0"
                              ItemsSource="{Binding GodownChoices}"
                              SelectedItem="{Binding DefaultGodown}"
                              DisplayMemberPath="Name" />
                    <Button Content="Add line" Margin="16,0,0,0" Padding="14,5"
                            Command="{Binding AddLineCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Lines}"
                  SelectedItem="{Binding SelectedLine}"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridComboBoxColumn Header="Direction" Width="90"
                                        ItemsSource="{Binding DataContext.DirectionChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        SelectedItemBinding="{Binding Direction}" />
                <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" IsReadOnly="True" Width="*" />
                <DataGridComboBoxColumn Header="Godown" Width="130"
                                        ItemsSource="{Binding DataContext.GodownChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        SelectedValueBinding="{Binding GodownId}"
                                        SelectedValuePath="Id"
                                        DisplayMemberPath="Name" />
                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80" />
                <DataGridTextColumn Header="Unit cost (receipts)" Binding="{Binding UnitCost}" Width="110" />
                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="100" />
                <DataGridTextColumn Header="Serials (; separated)" Binding="{Binding SerialNumbers}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3">
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Validate" Padding="14,5" Command="{Binding ValidateCommand}" />
                <Button Content="Post voucher" Margin="8,0,0,0" Padding="14,5"
                        Command="{Binding PostCommand}" />
                <Button Content="Remove selected line" Margin="16,0,0,0" Padding="14,5"
                        Command="{Binding RemoveLineCommand}" />
                <Button Content="Refresh" Margin="16,0,0,0" Padding="14,5"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>

            <TextBlock Margin="4,8,0,0" Text="{Binding Status}" Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap" />

            <TextBlock Margin="4,12,0,2" Text="Recent movements" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}" />
            <DataGrid Height="160"
                      ItemsSource="{Binding RecentVouchers}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="110" />
                    <DataGridTextColumn Header="Date" Binding="{Binding VoucherDate}" Width="90" />
                    <DataGridTextColumn Header="Purpose" Binding="{Binding Purpose}" Width="120" />
                    <DataGridTextColumn Header="Narration" Binding="{Binding Narration}" Width="*" />
                    <DataGridTextColumn Header="Lines" Binding="{Binding Lines.Count}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</UserControl>
