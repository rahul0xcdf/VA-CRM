<UserControl x:Class="VinayakaAgencies.App.Views.TaxSectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">

    <!--
        Master-list page (ADR-0006 shape, ADR-0007 internals). Two lists: the sections, and the
        dated rate rows of whichever is selected. Checkpoint C7.2 is this screen — a section
        becomes usable by typing it, with no rebuild.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="TDS / TCS sections" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="section, rate and threshold — all data, never code"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="Show retired" Style="{StaticResource FieldCheck}"
                          IsChecked="{Binding IncludeInactive}" />
                <Button Content="Refresh" Style="{StaticResource BandButton}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <DataGrid Style="{StaticResource PageGrid}"
                          ItemsSource="{Binding SectionRows}"
                          SelectedItem="{Binding SelectedSection}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="60" />
                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="100" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="2025 code" Binding="{Binding StatutePaymentCode}"
                                            Width="80" />
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Style="{StaticResource EmptyStateText}"
                           Text="No sections yet. Nothing is seeded — add the ones this business actually deducts under."
                           Visibility="{Binding SectionRows.Count, Converter={StaticResource ZeroToVisibility}}" />
            </Grid>

            <DataGrid Grid.Column="1" Style="{StaticResource PageGrid}"
                      ItemsSource="{Binding RateRows}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Payee class" Binding="{Binding PayeeCategory}" Width="110" />
                    <DataGridTextColumn Header="Rate" Binding="{Binding Rate}" Width="70"
                                        ElementStyle="{StaticResource NumericCell}"
                                        HeaderStyle="{StaticResource NumericColumnHeader}" />
                    <DataGridTextColumn Header="No PAN" Binding="{Binding RateWithoutPan}" Width="70"
                                        ElementStyle="{StaticResource NumericCell}"
                                        HeaderStyle="{StaticResource NumericColumnHeader}" />
                    <DataGridTextColumn Header="Per payment" Binding="{Binding SingleThreshold}" Width="100"
                                        ElementStyle="{StaticResource NumericCell}"
                                        HeaderStyle="{StaticResource NumericColumnHeader}" />
                    <DataGridTextColumn Header="Per year" Binding="{Binding AnnualThreshold}" Width="100"
                                        ElementStyle="{StaticResource NumericCell}"
                                        HeaderStyle="{StaticResource NumericColumnHeader}" />
                    <DataGridTextColumn Header="From" Binding="{Binding EffectiveFromText}" Width="100" />
                    <DataGridTextColumn Header="To" Binding="{Binding EffectiveToText}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource EntryPanelStyle}">
            <StackPanel>
                <TextBlock Text="SECTION" Style="{StaticResource EntryHeadingText}" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Kind" Style="{StaticResource FieldLabel}" />
                    <ComboBox Width="80" Style="{StaticResource FieldCombo}"
                              ItemsSource="{Binding KindChoices}"
                              SelectedItem="{Binding EditKind}" />

                    <TextBlock Text="Code" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="110" Style="{StaticResource FieldBox}"
                             Text="{Binding EditCode, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="280" Style="{StaticResource FieldBox}"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="2025 payment code" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="90" Style="{StaticResource FieldBox}"
                             Text="{Binding EditStatutePaymentCode, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Content="Save section" Style="{StaticResource BandButton}"
                            Command="{Binding SaveSectionCommand}" />
                </StackPanel>

                <TextBlock Text="RATE FROM A DATE" Style="{StaticResource EntryHeadingText}"
                           Margin="0,10,0,0" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Payee class" Style="{StaticResource FieldLabel}" />
                    <ComboBox Width="130" Style="{StaticResource FieldCombo}"
                              ItemsSource="{Binding CategoryChoices}"
                              SelectedItem="{Binding RateCategory}" />

                    <TextBlock Text="Rate %" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="70" Style="{StaticResource FieldBox}"
                             Text="{Binding RatePercent, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="No-PAN %" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="70" Style="{StaticResource FieldBox}"
                             Text="{Binding RateWithoutPanPercent, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Per payment" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="90" Style="{StaticResource FieldBox}"
                             Text="{Binding SingleThreshold, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Per year" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="90" Style="{StaticResource FieldBox}"
                             Text="{Binding AnnualThreshold, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="From" Style="{StaticResource FieldLabel}" />
                    <DatePicker Width="120" SelectedDate="{Binding RateEffectiveFrom}" />

                    <Button Content="Add rate" Style="{StaticResource BandButton}"
                            Command="{Binding AddRateCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                    <Button Content="New" Style="{StaticResource BandButton}"
                            Command="{Binding ClearEditorCommand}" />
                    <Border Width="1" Margin="4,2,12,2" Background="{StaticResource ControlBorderBrush}" />
                    <Button Content="Retire" Style="{StaticResource BandButton}"
                            Command="{Binding DeactivateSelectedCommand}" />
                    <Button Content="Reactivate" Style="{StaticResource BandButton}"
                            Command="{Binding ActivateSelectedCommand}" />
                </StackPanel>

                <TextBlock Style="{StaticResource PageHintText}" Margin="0,8,0,0"
                           Text="A blank threshold means the section has no such test. Leave both blank to deduct from the first rupee." />
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource PageStatusStyle}">
            <TextBlock Text="{Binding Status}" Style="{StaticResource PageStatusText}" />
        </Border>
    </Grid>
</UserControl>
