<UserControl x:Class="VinayakaAgencies.App.Views.TradeDocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:VinayakaAgencies.App.Views"
             mc:Ignorable="d"
             d:DesignHeight="860" d:DesignWidth="1280">

    <UserControl.Resources>
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </UserControl.Resources>

    <!-- Voucher page (ADR-0006): document header, line grid, two action bands, then the document
         list the operator loads from. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="190" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Documents" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="quotations, orders, challans and invoices, sales and purchase"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
                <TextBlock Text="{Binding EditingCaption}" Margin="18,0,0,0"
                           Style="{StaticResource PageTitleText}"
                           Foreground="{StaticResource AccentBrush}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Document" Style="{StaticResource FieldLabel}" />
                    <ComboBox Width="150" Style="{StaticResource FieldCombo}"
                              ItemsSource="{Binding KindChoices}" SelectedItem="{Binding NewDocumentKind}" />
                    <Button Content="New" Style="{StaticResource BandButton}"
                            Command="{Binding StartNewDocumentCommand}" />

                    <TextBlock Text="Date" Style="{StaticResource FieldLabel}" />
                    <DatePicker Width="130" Margin="0,0,16,0" VerticalAlignment="Center"
                                SelectedDate="{Binding DocumentDate}" />

                    <TextBlock Text="Party" Style="{StaticResource FieldLabel}" />
                    <ComboBox Width="230" Style="{StaticResource FieldCombo}"
                              ItemsSource="{Binding LedgerChoices}"
                              SelectedItem="{Binding PartyLedger}" DisplayMemberPath="Name" />

                    <TextBlock Text="Your ref" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="120" MinWidth="0" Style="{StaticResource FieldBox}"
                             Text="{Binding PartyReferenceNumber, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Narration" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="300" Style="{StaticResource FieldBox}"
                             Text="{Binding Narration, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Find item" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="170" MinWidth="0" Style="{StaticResource FieldBox}"
                             Text="{Binding ItemSearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Search" Style="{StaticResource BandButton}"
                            Command="{Binding SearchItemsCommand}" />

                    <ComboBox Width="230" Style="{StaticResource FieldCombo}"
                              ItemsSource="{Binding ItemChoices}"
                              SelectedItem="{Binding SelectedNewItem}" DisplayMemberPath="Name" />

                    <TextBlock Text="Godown" Style="{StaticResource FieldLabel}" />
                    <ComboBox Width="140" Style="{StaticResource FieldCombo}"
                              ItemsSource="{Binding GodownChoices}"
                              SelectedItem="{Binding DefaultGodown}" DisplayMemberPath="Name" />

                    <Button Content="Add line" Style="{StaticResource BandButton}"
                            Command="{Binding AddLineCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" Style="{StaticResource PageGrid}" IsReadOnly="False"
                  ItemsSource="{Binding Lines}"
                  SelectedItem="{Binding SelectedLine}"
                  IsEnabled="{Binding IsEditingEnabled}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" IsReadOnly="True" Width="*" />
                <DataGridComboBoxColumn Header="Godown" Width="140"
                                        ItemsSource="{Binding DataContext.GodownChoices,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        SelectedValueBinding="{Binding GodownId}"
                                        SelectedValuePath="Id" DisplayMemberPath="Name" />
                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="90"
                                    ElementStyle="{StaticResource NumericCell}"
                                    HeaderStyle="{StaticResource NumericColumnHeader}" />

                <DataGridTemplateColumn Header="Rate" Width="110"
                                        HeaderStyle="{StaticResource NumericColumnHeader}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Rate}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <!-- Locked when the override gate is off and a price was auto-applied. -->
                            <TextBox Text="{Binding Rate, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsRateLocked,
                                         Converter={StaticResource InverseBooleanConverter}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Disc %" Binding="{Binding DiscountPercent}" Width="76"
                                    ElementStyle="{StaticResource NumericCell}"
                                    HeaderStyle="{StaticResource NumericColumnHeader}" />

                <!-- An overridden price is called out in the warning colour: C4.2 wants the override
                     visible on the line, not only in the audit trail. -->
                <DataGridTextColumn Header="Priced from" Binding="{Binding PriceSourceLabel}"
                                    IsReadOnly="True" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPriceOverridden}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="110" />
                <DataGridTextColumn Header="Serials (; separated)" Binding="{Binding SerialNumbers}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Style="{StaticResource TotalsBandStyle}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Save draft" Style="{StaticResource BandButton}"
                        Command="{Binding SaveDraftCommand}" />
                <Button Content="Remove line" Style="{StaticResource BandButton}"
                        Command="{Binding RemoveLineCommand}" />
                <Button Content="Load selected" Style="{StaticResource BandButton}"
                        Command="{Binding LoadSelectedCommand}" />
                <Button Content="Delete draft" Style="{StaticResource BandButton}"
                        Command="{Binding DeleteDocumentCommand}" />

                <Border Width="1" Margin="4,2,12,2" Background="{StaticResource ControlBorderBrush}" />

                <TextBlock Text="Convert into" Style="{StaticResource FieldLabel}" />
                <ComboBox Width="140" Style="{StaticResource FieldCombo}"
                          ItemsSource="{Binding ConvertTargets}"
                          SelectedItem="{Binding SelectedTargetKind}" />
                <TextBlock Text="Godown" Style="{StaticResource FieldLabel}" />
                <ComboBox Width="130" Style="{StaticResource FieldCombo}"
                          ItemsSource="{Binding GodownChoices}"
                          SelectedItem="{Binding ConvertGodown}" DisplayMemberPath="Name" />
                <DatePicker Width="120" Margin="0,0,12,0" VerticalAlignment="Center"
                            SelectedDate="{Binding ConvertDate}" />
                <Button Content="Convert" Style="{StaticResource BandButton}" Command="{Binding ConvertCommand}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource EntryPanelStyle}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Validate invoice" Style="{StaticResource BandButton}"
                        Command="{Binding ValidateInvoiceCommand}" />
                <Button Content="Post invoice" Style="{StaticResource BandButton}"
                        ToolTip="Journal voucher, stock voucher, ledger rows and serial lifecycle in one transaction."
                        Command="{Binding PostInvoiceCommand}" />

                <Border Width="1" Margin="4,2,12,2" Background="{StaticResource ControlBorderBrush}" />

                <TextBlock Text="Reason" Style="{StaticResource FieldLabel}" />
                <TextBox Width="230" Style="{StaticResource FieldBox}"
                         ToolTip="Kept in the edit log against the reversal."
                         Text="{Binding CancellationReason, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Reverse issued invoice" Style="{StaticResource BandButton}"
                        Command="{Binding CancelPostedInvoiceCommand}" />

                <Border Width="1" Margin="4,2,12,2" Background="{StaticResource ControlBorderBrush}" />

                <Button Content="Print / preview" Style="{StaticResource BandButton}"
                        Command="{Binding PrintCommand}" />
                <Button Content="Refresh" Style="{StaticResource BandButton}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="5" Style="{StaticResource PageGrid}"
                  ItemsSource="{Binding Documents}"
                  SelectedItem="{Binding SelectedDocument}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Number" Binding="{Binding DisplayNumber}" Width="130" />
                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="130" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95" />
                <DataGridTextColumn Header="Date" Binding="{Binding DocumentDate}" Width="100" />
                <DataGridTextColumn Header="Party" Binding="{Binding PartyLedgerName}" Width="*" />
                <DataGridTextColumn Header="Converted from" Binding="{Binding ConvertedFromNumber}" Width="130" />
                <DataGridTextColumn Header="Total" Binding="{Binding TotalNetValue, StringFormat=N2}" Width="120"
                                    ElementStyle="{StaticResource NumericCell}"
                                    HeaderStyle="{StaticResource NumericColumnHeader}" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="6" Style="{StaticResource PageStatusStyle}">
            <StackPanel>
                <TextBlock Text="{Binding EditingStatus}" Style="{StaticResource PageStatusText}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource PageStatusText}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
