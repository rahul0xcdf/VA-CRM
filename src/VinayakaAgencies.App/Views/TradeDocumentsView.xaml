<UserControl x:Class="VinayakaAgencies.App.Views.TradeDocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:VinayakaAgencies.App.Presentation.Controls"
             xmlns:presentation="clr-namespace:VinayakaAgencies.App.Presentation"
             mc:Ignorable="d"
             d:DesignHeight="860" d:DesignWidth="1280">

    <UserControl.Resources>
        <presentation:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <!--
        Voucher page (ADR-0006 shape, ADR-0007 internals): document header, the line grid as
        permanently live fields, two action bands, then the document list the operator loads from.

        The document kind is on F8 / F9 / Ctrl+F8 / Ctrl+F9 / Alt+F8 / Alt+F9 / F10 and marked on the
        button bar, so the combo box that carried it is gone — the caption in the header says which
        kind is being staged.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="170" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Documents" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="quotations, orders, challans and invoices, sales and purchase"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
                <TextBlock Text="{Binding EditingCaption}" Margin="18,0,0,0"
                           Style="{StaticResource PageTitleText}"
                           Foreground="{StaticResource AccentBrush}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Date" Style="{StaticResource FieldLabel}" />
                    <DatePicker Width="130" Margin="0,0,16,0" VerticalAlignment="Center"
                                SelectedDate="{Binding DocumentDate}" />

                    <TextBlock Text="Party" Style="{StaticResource FieldLabel}" />
                    <controls:LookupBox Style="{StaticResource FieldLookup}" Width="240"
                                        Watermark="Party ledger"
                                        DisplayMemberPath="Name"
                                        ItemsSource="{Binding LedgerChoices}"
                                        SelectedItem="{Binding PartyLedger, Mode=TwoWay}" />

                    <TextBlock Text="Your ref" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="120" MinWidth="0" Style="{StaticResource FieldBox}"
                             Text="{Binding PartyReferenceNumber, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Narration" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="260" Style="{StaticResource FieldBox}"
                             Text="{Binding Narration, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <!-- One field where there used to be a search box, a Search button and a list. -->
                    <TextBlock Text="Item" Style="{StaticResource FieldLabel}" />
                    <controls:LookupBox Style="{StaticResource FieldLookup}" Width="330"
                                        Watermark="Type any part of the name or code"
                                        DisplayMemberPath="Name"
                                        CreateLabel="Create item"
                                        ItemsSource="{Binding ItemChoices}"
                                        Text="{Binding ItemSearchText, Mode=TwoWay}"
                                        CreateCommand="{Binding BeginCreateItemCommand}"
                                        SelectedItem="{Binding SelectedNewItem, Mode=TwoWay}" />

                    <TextBlock Text="Into godown" Style="{StaticResource FieldLabel}" />
                    <controls:LookupBox Style="{StaticResource FieldLookup}" Width="150"
                                        Watermark="Godown"
                                        DisplayMemberPath="Name"
                                        ItemsSource="{Binding GodownChoices}"
                                        SelectedItem="{Binding DefaultGodown, Mode=TwoWay}" />

                    <Button Content="Add line" Style="{StaticResource BandButton}"
                            Command="{Binding AddLineCommand}" />
                    <Button Content="New document" Style="{StaticResource BandButton}"
                            Command="{Binding StartNewDocumentCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource EntryHeaderBand}">
            <Grid Margin="0,0,17,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Item" Style="{StaticResource EntryColumnHeaderText}" />
                <TextBlock Grid.Column="1" Text="Godown" Style="{StaticResource EntryColumnHeaderText}" />
                <TextBlock Grid.Column="2" Text="Qty" Style="{StaticResource EntryNumberColumnHeaderText}" />
                <TextBlock Grid.Column="3" Text="Rate" Style="{StaticResource EntryNumberColumnHeaderText}" />
                <TextBlock Grid.Column="4" Text="Disc %" Style="{StaticResource EntryNumberColumnHeaderText}" />
                <TextBlock Grid.Column="5" Text="Priced from" Style="{StaticResource EntryColumnHeaderText}" />
                <TextBlock Grid.Column="6" Text="Batch" Style="{StaticResource EntryColumnHeaderText}" />
                <TextBlock Grid.Column="7" Text="Serials (; separated)"
                           Style="{StaticResource EntryColumnHeaderText}" />
            </Grid>
        </Border>

        <!--
            No AppendRowCommand: a document line needs an item chosen up in the picker before it can
            exist, so Enter on the last field stops rather than conjuring a line with no item.
        -->
        <ItemsControl Grid.Row="3"
                      ItemsSource="{Binding Lines}"
                      Focusable="False"
                      IsEnabled="{Binding IsEditingEnabled}"
                      controls:EntryGrid.Enable="True"
                      controls:EntryGrid.CurrentItem="{Binding SelectedLine, Mode=TwoWay}">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer Focusable="False"
                                  VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource EntryLineBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding ItemName}" Margin="6,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource PrimaryTextBrush}" />

                            <controls:LookupBox Grid.Column="1"
                                                Watermark="Godown"
                                                DisplayMemberPath="Name"
                                                ItemsSource="{Binding DataContext.GodownChoices,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                SelectedItem="{Binding Godown, Mode=TwoWay}" />

                            <TextBox Grid.Column="2" Style="{StaticResource EntryNumberField}"
                                     Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />

                            <!-- Locked, not hidden, when the override gate is off and a price was
                                 auto-applied (C4.5): the operator must see the rate they cannot
                                 change, or they will not know why the total is what it is. -->
                            <TextBox Grid.Column="3" Style="{StaticResource EntryNumberField}"
                                     Text="{Binding Rate, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding IsRateLocked}"
                                     ToolTip="{Binding PriceSourceLabel, StringFormat=Priced from {0}}" />

                            <TextBox Grid.Column="4" Style="{StaticResource EntryNumberField}"
                                     Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}" />

                            <!-- An overridden price is called out in the warning colour: C4.2 wants
                                 the override visible on the line, not only in the audit trail. -->
                            <TextBlock Grid.Column="5" Text="{Binding PriceSourceLabel}" Margin="6,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource SecondaryTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPriceOverridden}" Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource WarningBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBox Grid.Column="6" Style="{StaticResource EntryField}"
                                     Text="{Binding BatchNumber, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBox Grid.Column="7" Style="{StaticResource EntryField}"
                                     Text="{Binding SerialNumbers, UpdateSourceTrigger=PropertyChanged}" />

                            <Button Grid.Column="8" Content="−" Style="{StaticResource EntryLineButton}"
                                    ToolTip="Remove this line (Ctrl+D)"
                                    Command="{Binding DataContext.RemoveLineCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="4" Style="{StaticResource TotalsBandStyle}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Save draft" Style="{StaticResource BandButton}"
                        Command="{Binding SaveDraftCommand}" />
                <Button Content="Remove line" Style="{StaticResource BandButton}"
                        Command="{Binding RemoveLineCommand}" />
                <Button Content="Load selected" Style="{StaticResource BandButton}"
                        Command="{Binding LoadSelectedCommand}" />
                <Button Content="Delete draft" Style="{StaticResource BandButton}"
                        Command="{Binding DeleteDocumentCommand}" />

                <Border Width="1" Margin="4,2,12,2" Background="{StaticResource ControlBorderBrush}" />

                <TextBlock Text="Convert into" Style="{StaticResource FieldLabel}" />
                <ComboBox Width="140" Style="{StaticResource FieldCombo}"
                          ItemsSource="{Binding ConvertTargets}"
                          SelectedItem="{Binding SelectedTargetKind}" />
                <TextBlock Text="Godown" Style="{StaticResource FieldLabel}" />
                <ComboBox Width="130" Style="{StaticResource FieldCombo}"
                          ItemsSource="{Binding GodownChoices}"
                          SelectedItem="{Binding ConvertGodown}" DisplayMemberPath="Name" />
                <DatePicker Width="120" Margin="0,0,12,0" VerticalAlignment="Center"
                            SelectedDate="{Binding ConvertDate}" />
                <Button Content="Convert" Style="{StaticResource BandButton}" Command="{Binding ConvertCommand}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource EntryPanelStyle}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Validate invoice" Style="{StaticResource BandButton}"
                        Command="{Binding ValidateInvoiceCommand}" />
                <Button Content="Post invoice" Style="{StaticResource BandButton}"
                        ToolTip="Journal voucher, stock voucher, ledger rows and serial lifecycle in one transaction."
                        Command="{Binding PostInvoiceCommand}" />

                <Border Width="1" Margin="4,2,12,2" Background="{StaticResource ControlBorderBrush}" />

                <TextBlock Text="Reason" Style="{StaticResource FieldLabel}" />
                <TextBox Width="230" Style="{StaticResource FieldBox}"
                         ToolTip="Kept in the edit log against the reversal."
                         Text="{Binding CancellationReason, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Reverse issued invoice" Style="{StaticResource BandButton}"
                        Command="{Binding CancelPostedInvoiceCommand}" />

                <Border Width="1" Margin="4,2,12,2" Background="{StaticResource ControlBorderBrush}" />

                <Button Content="Print / preview" Style="{StaticResource BandButton}"
                        Command="{Binding PrintCommand}" />
                <Button Content="Refresh" Style="{StaticResource BandButton}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Border>

        <!-- Alt+C lands here. -->
        <Border Grid.Row="6" Style="{StaticResource EntryPanelStyle}"
                Visibility="{Binding IsCreatingItem, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="NEW ITEM — CTRL+A SAVES IT AND SELECTS IT"
                           Style="{StaticResource EntryHeadingText}" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="260" Style="{StaticResource FieldBox}"
                             Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Base unit" Style="{StaticResource FieldLabel}" />
                    <controls:LookupBox Style="{StaticResource FieldLookup}" Width="120"
                                        Watermark="Unit"
                                        DisplayMemberPath="Code"
                                        ItemsSource="{Binding UnitChoices}"
                                        SelectedItem="{Binding NewItemUnit, Mode=TwoWay}" />

                    <TextBlock Text="Stock group" Style="{StaticResource FieldLabel}" />
                    <controls:LookupBox Style="{StaticResource FieldLookup}" Width="200"
                                        Watermark="Optional"
                                        DisplayMemberPath="Name"
                                        ItemsSource="{Binding StockGroupChoices}"
                                        SelectedItem="{Binding NewItemGroup, Mode=TwoWay}" />

                    <Button Content="Save item" Style="{StaticResource BandButton}"
                            Command="{Binding ConfirmCreateItemCommand}" />
                    <Button Content="Abandon" Style="{StaticResource BandButton}"
                            Command="{Binding CancelCreateItemCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="7" Style="{StaticResource PageGrid}"
                  ItemsSource="{Binding Documents}"
                  SelectedItem="{Binding SelectedDocument}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Number" Binding="{Binding DisplayNumber}" Width="130" />
                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="130" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95" />
                <DataGridTextColumn Header="Date" Binding="{Binding DocumentDate}" Width="100" />
                <DataGridTextColumn Header="Party" Binding="{Binding PartyLedgerName}" Width="*" />
                <DataGridTextColumn Header="Converted from" Binding="{Binding ConvertedFromNumber}" Width="130" />
                <DataGridTextColumn Header="Total" Binding="{Binding TotalNetValue, StringFormat=N2}" Width="120"
                                    ElementStyle="{StaticResource NumericCell}"
                                    HeaderStyle="{StaticResource NumericColumnHeader}" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="8" Style="{StaticResource PageStatusStyle}">
            <StackPanel>
                <TextBlock Text="{Binding EditingStatus}" Style="{StaticResource PageStatusText}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource PageStatusText}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
