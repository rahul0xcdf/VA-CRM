<UserControl x:Class="VinayakaAgencies.App.Views.TradeDocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:VinayakaAgencies.App.Views"
             mc:Ignorable="d"
             d:DesignHeight="860" d:DesignWidth="1280">

    <UserControl.Resources>
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Documents — quotations, orders, challans and invoices, sales and purchase"
                   Style="{StaticResource ScreenTitleText}" />

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" Padding="12" Margin="0,10,0,8" CornerRadius="6"
                BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Document:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <ComboBox Width="140" Margin="6,0,16,0"
                              ItemsSource="{Binding KindChoices}"
                              SelectedItem="{Binding NewDocumentKind}" />
                    <Button Content="New document" Padding="14,5" Command="{Binding StartNewDocumentCommand}" />
                    <TextBlock Text="{Binding EditingCaption}" Margin="16,0,16,0"
                               VerticalAlignment="Center" Style="{StaticResource SectionHeaderText}" />
                    <TextBlock Text="Date:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <DatePicker Width="120" Margin="6,0,16,0" SelectedDate="{Binding DocumentDate}" />
                    <TextBlock Text="Party:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <ComboBox Width="220" Margin="6,0,16,0"
                              ItemsSource="{Binding LedgerChoices}"
                              SelectedItem="{Binding PartyLedger}"
                              DisplayMemberPath="Name" />
                    <TextBlock Text="Your ref:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Width="110" Margin="6,0,0,0"
                             Text="{Binding PartyReferenceNumber, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Narration:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Width="300" Margin="6,0,16,0"
                             Text="{Binding Narration, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Find item:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox Width="160" Margin="6,0,6,0"
                             Text="{Binding ItemSearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Search" Padding="14,5" Command="{Binding SearchItemsCommand}" />
                    <ComboBox Width="220" Margin="8,0,16,0"
                              ItemsSource="{Binding ItemChoices}"
                              SelectedItem="{Binding SelectedNewItem}"
                              DisplayMemberPath="Name" />
                    <TextBlock Text="Default godown:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <ComboBox Width="130" Margin="6,0,0,0"
                              ItemsSource="{Binding GodownChoices}"
                              SelectedItem="{Binding DefaultGodown}"
                              DisplayMemberPath="Name" />
                    <Button Content="Add line" Margin="14,0,0,0" Padding="14,5"
                            Command="{Binding AddLineCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Lines}"
                  SelectedItem="{Binding SelectedLine}"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  CanUserAddRows="False" IsEnabled="{Binding IsEditingEnabled}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" IsReadOnly="True" Width="*" />
                <DataGridComboBoxColumn Header="Godown" Width="130"
                                        ItemsSource="{Binding DataContext.GodownChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        SelectedValueBinding="{Binding GodownId}"
                                        SelectedValuePath="Id"
                                        DisplayMemberPath="Name" />
                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80" />
                <DataGridTemplateColumn Header="Rate" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Rate}" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <!-- Locked when the override gate is off and a price was auto-applied. -->
                            <TextBox Text="{Binding Rate, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsRateLocked, Converter={StaticResource InverseBooleanConverter}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Disc %" Binding="{Binding DiscountPercent}" Width="70" />
                <DataGridTextColumn Header="Priced from" Binding="{Binding PriceSourceLabel}" IsReadOnly="True" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPriceOverridden}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="100" />
                <DataGridTextColumn Header="Serials (; separated)" Binding="{Binding SerialNumbers}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3">
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Save draft" Padding="14,5" Command="{Binding SaveDraftCommand}" />
                <Button Content="Remove line" Margin="8,0,0,0" Padding="14,5"
                        Command="{Binding RemoveLineCommand}" />
                <Button Content="Load selected ↓" Margin="16,0,0,0" Padding="14,5"
                        Command="{Binding LoadSelectedCommand}" />
                <Button Content="Delete draft" Margin="8,0,0,0" Padding="14,5"
                        Command="{Binding DeleteDocumentCommand}" />
                <TextBlock Text="Convert into:" VerticalAlignment="Center" Margin="20,0,4,0"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <ComboBox Width="130"
                          ItemsSource="{Binding ConvertTargets}"
                          SelectedItem="{Binding SelectedTargetKind}" />
                <TextBlock Text="godown:" VerticalAlignment="Center" Margin="6,0,4,0"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <ComboBox Width="120"
                          ItemsSource="{Binding GodownChoices}"
                          SelectedItem="{Binding ConvertGodown}"
                          DisplayMemberPath="Name" />
                <DatePicker Width="110" Margin="6,0,6,0" SelectedDate="{Binding ConvertDate}" />
                <Button Content="Convert" Padding="14,5" Command="{Binding ConvertCommand}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Validate invoice" Padding="14,5" Command="{Binding ValidateInvoiceCommand}" />
                <Button Content="Post invoice (atomic)" Margin="8,0,0,0" Padding="14,5"
                        Command="{Binding PostInvoiceCommand}" />
                <TextBox Width="220" Margin="20,0,6,0"
                         ToolTip="Reason kept in the edit log"
                         Text="{Binding CancellationReason, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Reverse issued invoice" Padding="14,5"
                        Command="{Binding CancelPostedInvoiceCommand}" />
                <Button Content="Print / preview" Margin="20,0,0,0" Padding="14,5"
                        Command="{Binding PrintCommand}" />
                <Button Content="Refresh" Margin="8,0,0,0" Padding="14,5"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>

            <TextBlock Margin="4,8,0,0" Text="{Binding EditingStatus}" Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="4,4,0,0" Text="{Binding Status}" Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap" />

            <TextBlock Margin="4,12,0,2" Text="All documents (latest 100)" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}" />
            <DataGrid Height="190"
                      ItemsSource="{Binding Documents}"
                      SelectedItem="{Binding SelectedDocument}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Number" Binding="{Binding DisplayNumber}" Width="120" />
                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="120" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                    <DataGridTextColumn Header="Date" Binding="{Binding DocumentDate}" Width="95" />
                    <DataGridTextColumn Header="Party" Binding="{Binding PartyLedgerName}" Width="*" />
                    <DataGridTextColumn Header="Converted from" Binding="{Binding ConvertedFromNumber}" Width="120" />
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalNetValue}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</UserControl>
