<UserControl x:Class="VinayakaAgencies.App.Views.TrialBalanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="980">

    <!-- Report page with drill-down (ADR-0006): criteria band, the report, a labelled split, the
         selected ledger's entries, then totals. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Trial balance" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="select a ledger to drill into its statement"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="As on" Style="{StaticResource FieldLabel}" />
                <DatePicker Width="140" Margin="0,0,16,0" VerticalAlignment="Center"
                            SelectedDate="{Binding AsOnDate}" />
                <Button Content="Load" Style="{StaticResource BandButton}" Command="{Binding LoadCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <DataGrid Style="{StaticResource PageGrid}"
                      ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ledger" Binding="{Binding LedgerName}" Width="2.4*" />
                    <DataGridTextColumn Header="Group" Binding="{Binding AccountGroupName}" Width="1.6*" />
                    <DataGridTextColumn Header="Nature" Binding="{Binding Nature}" Width="120" />
                    <DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat=N2}" Width="130"
                                        ElementStyle="{StaticResource NumericCell}"
                                        HeaderStyle="{StaticResource NumericColumnHeader}" />
                    <DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat=N2}" Width="130"
                                        ElementStyle="{StaticResource NumericCell}"
                                        HeaderStyle="{StaticResource NumericColumnHeader}" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Style="{StaticResource EmptyStateText}"
                       Text="Nothing posted as on this date. Pick another date and press Load."
                       Visibility="{Binding Rows.Count, Converter={StaticResource ZeroToVisibility}}" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource TotalsBandStyle}">
            <TextBlock Text="ENTRIES IN THE SELECTED LEDGER" Style="{StaticResource EntryHeadingText}" Margin="0" />
        </Border>

        <DataGrid Grid.Row="4" Style="{StaticResource PageGrid}" ItemsSource="{Binding DrillDownRows}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding VoucherDate, StringFormat=dd-MMM-yy}" Width="100" />
                <DataGridTextColumn Header="Voucher" Binding="{Binding VoucherNumber}" Width="130" />
                <DataGridTextColumn Header="Type" Binding="{Binding VoucherTypeName}" Width="130" />
                <DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat=N2}" Width="120"
                                    ElementStyle="{StaticResource NumericCell}"
                                    HeaderStyle="{StaticResource NumericColumnHeader}" />
                <DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat=N2}" Width="120"
                                    ElementStyle="{StaticResource NumericCell}"
                                    HeaderStyle="{StaticResource NumericColumnHeader}" />
                <DataGridTextColumn Header="Narration" Binding="{Binding Narration}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="5" Style="{StaticResource TotalsBandStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Total Dr" Style="{StaticResource TotalsLabelText}" />
                <TextBlock Text="{Binding TotalDebit, StringFormat=N2}" Style="{StaticResource TotalsValueText}" />
                <TextBlock Text="Total Cr" Style="{StaticResource TotalsLabelText}" />
                <TextBlock Text="{Binding TotalCredit, StringFormat=N2}" Style="{StaticResource TotalsValueText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="6" Style="{StaticResource PageStatusStyle}">
            <TextBlock Text="{Binding Status}" Style="{StaticResource PageStatusText}" />
        </Border>
    </Grid>
</UserControl>
