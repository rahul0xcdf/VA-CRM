<UserControl x:Class="VinayakaAgencies.App.Views.TrialBalanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="980">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Trial balance â€” select a ledger to drill into its statement"
                   Style="{StaticResource ScreenTitleText}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,8">
            <TextBlock Text="As on:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
            <DatePicker Width="130" Margin="6,0,16,0" SelectedDate="{Binding AsOnDate}" />
            <Button Content="Load" Padding="16,5" Command="{Binding LoadCommand}" />
        </StackPanel>

        <DataGrid Grid.Row="2" Margin="0,0,0,12"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ledger" Binding="{Binding LedgerName}" Width="2.4*" />
                <DataGridTextColumn Header="Group" Binding="{Binding AccountGroupName}" Width="1.6*" />
                <DataGridTextColumn Header="Nature" Binding="{Binding Nature}" Width="SizeToCells" />
                <DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat=N2}" Width="SizeToCells" />
                <DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat=N2}" Width="SizeToCells" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" Padding="12" CornerRadius="6"
                BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1">
            <DataGrid ItemsSource="{Binding DrillDownRows}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      BorderThickness="0" Background="Transparent"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding VoucherDate, StringFormat=dd-MMM-yy}" Width="SizeToCells" />
                    <DataGridTextColumn Header="Voucher" Binding="{Binding VoucherNumber}" Width="SizeToCells" />
                    <DataGridTextColumn Header="Type" Binding="{Binding VoucherTypeName}" Width="SizeToCells" />
                    <DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat=N2}" Width="SizeToCells" />
                    <DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat=N2}" Width="SizeToCells" />
                    <DataGridTextColumn Header="Narration" Binding="{Binding Narration}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="4,8,0,0">
            <TextBlock Text="Total Dr:" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding TotalDebit, StringFormat=N2}" Margin="6,0,16,0" FontWeight="SemiBold" />
            <TextBlock Text="Total Cr:" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding TotalCredit, StringFormat=N2}" Margin="6,0,20,0" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
