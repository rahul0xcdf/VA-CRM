<UserControl x:Class="VinayakaAgencies.App.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:VinayakaAgencies.App.Presentation.Controls"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="860">

    <!-- Master-list page (ADR-0006/0007). The role field is a LookupBox, never a ComboBox. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Users" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="every change to the books is recorded against one of these"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Refresh" Style="{StaticResource BandButton}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <DataGrid Style="{StaticResource PageGrid}"
                      ItemsSource="{Binding Users}"
                      SelectedItem="{Binding SelectedUser}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="User name" Binding="{Binding UserName}" Width="2*" />
                    <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="2*" />
                    <DataGridTextColumn Header="Role" Binding="{Binding RoleName}" Width="1.5*" />
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60" />
                    <DataGridCheckBoxColumn Header="Must change" Binding="{Binding MustChangePassword}" Width="90" />
                    <DataGridTextColumn Header="Last sign-in" Binding="{Binding LastSignInAtUtc}" Width="150" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Style="{StaticResource EmptyStateText}"
                       Text="No accounts yet. Until one exists, everybody on this install can do everything — create the owner account to change that."
                       Visibility="{Binding Users.Count, Converter={StaticResource ZeroToVisibility}}" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource EntryPanelStyle}">
            <StackPanel>
                <TextBlock Text="CREATE / ALTER" Style="{StaticResource EntryHeadingText}" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="User name" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="160" Style="{StaticResource FieldBox}"
                             Text="{Binding EditUserName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="200" Style="{StaticResource FieldBox}"
                             Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Role" Style="{StaticResource FieldLabel}" />
                    <controls:LookupBox Style="{StaticResource FieldLookup}" Width="180"
                                        Watermark="Type any part of the role"
                                        DisplayMemberPath="Name"
                                        ItemsSource="{Binding RoleChoices}"
                                        SelectedItem="{Binding EditRole, Mode=TwoWay}" />

                    <CheckBox Content="Can sign in" Style="{StaticResource FieldCheck}"
                              IsChecked="{Binding EditIsActive}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                    <PasswordBox Width="180" Margin="0,2,12,2"
                                 controls:PasswordBoxBinding.BoundPassword="{Binding EditPassword, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource PageHintText}" VerticalAlignment="Center"
                               Text="Set for a new account, or to reset one. The holder must change it at next sign-in." />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                    <Button Content="New" Style="{StaticResource BandButton}" Command="{Binding NewCommand}" />
                    <Button Content="Save" Style="{StaticResource BandButton}" Command="{Binding SaveCommand}" />
                    <Border Width="1" Margin="4,2,12,2" Background="{StaticResource ControlBorderBrush}" />
                    <Button Content="Reset password" Style="{StaticResource BandButton}"
                            Command="{Binding ResetPasswordCommand}" />
                    <Button Content="Deactivate" Style="{StaticResource BandButton}"
                            ToolTip="Accounts are never deleted — the audit trail names them for as long as the books exist."
                            Command="{Binding DeactivateSelectedCommand}" />
                    <Button Content="Reactivate" Style="{StaticResource BandButton}"
                            Command="{Binding ActivateSelectedCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource PageStatusStyle}">
            <TextBlock Text="{Binding Status}" Style="{StaticResource PageStatusText}" />
        </Border>
    </Grid>
</UserControl>
