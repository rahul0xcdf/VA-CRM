<UserControl x:Class="VinayakaAgencies.App.Views.VoucherEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:VinayakaAgencies.App.Presentation.Controls"
             xmlns:presentation="clr-namespace:VinayakaAgencies.App.Presentation"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="980">

    <!--
        Voucher page (ADR-0006 shape, ADR-0007 internals): header fields, the line grid, a totals band
        carrying the running difference, the create-a-ledger band, then the alter block.

        The difference is in the totals band rather than buried among the buttons because it is the
        one number an operator watches while typing — a voucher does not post until it reads zero.

        The lines are an ItemsControl of permanently live fields rather than a DataGrid of cells that
        enter edit mode when clicked. Enter walks across a line and wraps onto the next, adding one
        when it runs out; see Presentation/Controls/EntryGrid.cs.
    -->
    <UserControl.Resources>
        <presentation:BlankZeroDecimalConverter x:Key="BlankZero" />
        <presentation:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Voucher entry" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{Binding SelectedVoucherType.Name, StringFormat=· {0}}"
                           Margin="10,0,0,0" Style="{StaticResource PageTitleText}"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="F4-F9 switches type · debit and credit must agree before it will post"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Date" Style="{StaticResource FieldLabel}" />
                <DatePicker Width="130" Margin="0,0,16,0" VerticalAlignment="Center"
                            SelectedDate="{Binding EntryDate}" />

                <TextBlock Text="Narration" Style="{StaticResource FieldLabel}" />
                <TextBox Width="280" Style="{StaticResource FieldBox}"
                         Text="{Binding Narration, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Ref" Style="{StaticResource FieldLabel}" />
                <TextBox Width="110" MinWidth="0" Style="{StaticResource FieldBox}"
                         Text="{Binding ReferenceNumber}" />
                <DatePicker Width="130" Margin="0,0,16,0" VerticalAlignment="Center"
                            SelectedDate="{Binding ReferenceDate}" />

                <Button Content="Load lists" Style="{StaticResource BandButton}"
                        Command="{Binding LoadListsCommand}" />
            </StackPanel>
        </Border>

        <!-- Column header. The widths are repeated on every line below; the numeric columns are
             fixed so they stay aligned whatever the window does. -->
        <Border Grid.Row="2" Style="{StaticResource EntryHeaderBand}">
            <Grid Margin="0,0,17,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.4*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Ledger" Style="{StaticResource EntryColumnHeaderText}" />
                <TextBlock Grid.Column="1" Text="Debit" Style="{StaticResource EntryNumberColumnHeaderText}" />
                <TextBlock Grid.Column="2" Text="Credit" Style="{StaticResource EntryNumberColumnHeaderText}" />
                <TextBlock Grid.Column="3" Text="Line narration" Style="{StaticResource EntryColumnHeaderText}" />
            </Grid>
        </Border>

        <!-- The scrollbar is always shown so the fixed columns never shift under the header when a
             voucher grows past the visible rows. -->
        <ItemsControl Grid.Row="3"
                      ItemsSource="{Binding Lines}"
                      Focusable="False"
                      controls:EntryGrid.Enable="True"
                      controls:EntryGrid.AppendRowCommand="{Binding AddLineCommand}"
                      controls:EntryGrid.CurrentItem="{Binding CurrentLine, Mode=TwoWay}"
                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer Focusable="False"
                                  VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource EntryLineBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.4*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>

                            <controls:LookupBox Grid.Column="0"
                                                Watermark="Ledger name"
                                                DisplayMemberPath="Name"
                                                CreateLabel="Create ledger"
                                                ItemsSource="{Binding DataContext.Ledgers,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CreateCommand="{Binding DataContext.BeginCreateLedgerCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                SelectedItem="{Binding Ledger, Mode=TwoWay}" />

                            <TextBox Grid.Column="1" Style="{StaticResource EntryNumberField}"
                                     Text="{Binding Debit, Converter={StaticResource BlankZero},
                                            UpdateSourceTrigger=PropertyChanged}" />

                            <TextBox Grid.Column="2" Style="{StaticResource EntryNumberField}"
                                     Text="{Binding Credit, Converter={StaticResource BlankZero},
                                            UpdateSourceTrigger=PropertyChanged}" />

                            <TextBox Grid.Column="3" Style="{StaticResource EntryField}"
                                     Text="{Binding Narration, UpdateSourceTrigger=PropertyChanged}" />

                            <Button Grid.Column="4" Content="−" Style="{StaticResource EntryLineButton}"
                                    ToolTip="Remove this line (Ctrl+D)"
                                    Command="{Binding DataContext.RemoveLineCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="4" Style="{StaticResource TotalsBandStyle}">
            <Grid Margin="0,0,17,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.4*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>

                <!-- Totals sit under the columns they total, which is the only way a reader can
                     check them against the lines above without counting across. -->
                <TextBlock Grid.Column="0" Text="Total" Style="{StaticResource TotalsLabelText}"
                           Margin="6,0,0,0" />
                <TextBlock Grid.Column="1" Text="{Binding TotalDebit, StringFormat=N2}"
                           Style="{StaticResource TotalsValueText}" TextAlignment="Right"
                           Margin="0,0,8,0" />
                <TextBlock Grid.Column="2" Text="{Binding TotalCredit, StringFormat=N2}"
                           Style="{StaticResource TotalsValueText}" TextAlignment="Right"
                           Margin="0,0,8,0" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="6,0,0,0">
                    <TextBlock Text="Difference" Style="{StaticResource TotalsLabelText}" />
                    <TextBlock Text="{Binding Difference, StringFormat=N2}" FontSize="14"
                               Style="{StaticResource TotalsValueText}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--
            Alt+C lands here: a band, not a dialog. The half-typed voucher stays visible above it, so
            the operator can see that creating a ledger cost them nothing.
        -->
        <Border Grid.Row="5" Style="{StaticResource EntryPanelStyle}"
                Visibility="{Binding IsCreatingLedger, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="NEW LEDGER — Ctrl+A SAVES IT AND PUTS IT ON THE LINE"
                           Style="{StaticResource EntryHeadingText}" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="260" Style="{StaticResource FieldBox}"
                             Text="{Binding NewLedgerName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Under group" Style="{StaticResource FieldLabel}" />
                    <controls:LookupBox Style="{StaticResource FieldLookup}" Width="260"
                                        Watermark="Group name"
                                        DisplayMemberPath="Name"
                                        ItemsSource="{Binding AccountGroups}"
                                        SelectedItem="{Binding NewLedgerGroup, Mode=TwoWay}" />

                    <Button Content="Save ledger" Style="{StaticResource BandButton}"
                            Command="{Binding ConfirmCreateLedgerCommand}" />
                    <Button Content="Abandon" Style="{StaticResource BandButton}"
                            Command="{Binding CancelCreateLedgerCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="6" Style="{StaticResource EntryPanelStyle}">
            <StackPanel>
                <TextBlock Text="ALTER AN EXISTING VOUCHER" Style="{StaticResource EntryHeadingText}" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Voucher id" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="300" Style="{StaticResource FieldBox}" Text="{Binding AlterVoucherIdText}" />
                    <Button Content="Load for alter" Style="{StaticResource BandButton}"
                            Command="{Binding LoadForAlterCommand}" />
                    <Button Content="View history" Style="{StaticResource BandButton}"
                            Command="{Binding ViewHistoryCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Reason" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="380" Style="{StaticResource FieldBox}"
                             ToolTip="Required. The reason is written to the edit log with the change."
                             Text="{Binding ChangeReason, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Apply alteration" Style="{StaticResource BandButton}"
                            Command="{Binding ApplyAlterationCommand}" />
                    <Button Content="Cancel voucher" Style="{StaticResource BandButton}"
                            Command="{Binding CancelVoucherCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="7" Style="{StaticResource PageStatusStyle}">
            <!-- Read-only TextBox rather than a TextBlock: posting errors list every offending line,
                 and the operator needs to scroll and copy them. -->
            <TextBox Text="{Binding Status, Mode=OneWay}" IsReadOnly="True"
                     BorderThickness="0" Background="Transparent"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     FontSize="{StaticResource FontSize.Caption}"
                     TextWrapping="Wrap" MaxHeight="60" VerticalScrollBarVisibility="Auto" />
        </Border>
    </Grid>
</UserControl>
