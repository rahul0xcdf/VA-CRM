<UserControl x:Class="VinayakaAgencies.App.Views.VoucherEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="980">

    <!--
        Voucher page (ADR-0006): header fields, the line grid, a totals band carrying the running
        difference, then the alter block.

        The difference is in the totals band rather than buried among the buttons because it is the
        one number an operator watches while typing — a voucher does not post until it reads zero.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Voucher entry" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="debit and credit must agree before it will post"
                           Margin="12,0,0,0" Style="{StaticResource PageHintText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Type" Style="{StaticResource FieldLabel}" />
                <ComboBox Width="150" Style="{StaticResource FieldCombo}"
                          ItemsSource="{Binding VoucherTypes}"
                          SelectedItem="{Binding SelectedVoucherType}" DisplayMemberPath="Name" />

                <TextBlock Text="Date" Style="{StaticResource FieldLabel}" />
                <DatePicker Width="130" Margin="0,0,16,0" VerticalAlignment="Center"
                            SelectedDate="{Binding EntryDate}" />

                <TextBlock Text="Narration" Style="{StaticResource FieldLabel}" />
                <TextBox Width="260" Style="{StaticResource FieldBox}"
                         Text="{Binding Narration, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Ref" Style="{StaticResource FieldLabel}" />
                <TextBox Width="110" MinWidth="0" Style="{StaticResource FieldBox}"
                         Text="{Binding ReferenceNumber}" />
                <DatePicker Width="130" Margin="0,0,16,0" VerticalAlignment="Center"
                            SelectedDate="{Binding ReferenceDate}" />

                <Button Content="Load lists" Style="{StaticResource BandButton}"
                        Command="{Binding LoadListsCommand}" />
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" Style="{StaticResource PageGrid}" IsReadOnly="False"
                  CanUserDeleteRows="False"
                  ItemsSource="{Binding Lines}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Ledger" Width="2.4*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding LedgerId}" Margin="4,1" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.Ledgers,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedValue="{Binding LedgerId}"
                                      SelectedValuePath="Id" DisplayMemberPath="Name" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Debit" Width="130"
                                    Binding="{Binding Debit, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource NumericCell}"
                                    HeaderStyle="{StaticResource NumericColumnHeader}" />
                <DataGridTextColumn Header="Credit" Width="130"
                                    Binding="{Binding Credit, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource NumericCell}"
                                    HeaderStyle="{StaticResource NumericColumnHeader}" />
                <DataGridTextColumn Header="Line narration" Binding="{Binding Narration}" Width="*" />

                <DataGridTemplateColumn Header="" Width="36">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="−" Padding="6,0" MinWidth="0" ToolTip="Remove this line"
                                    Command="{Binding DataContext.RemoveLineCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Style="{StaticResource TotalsBandStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="+ Line" Style="{StaticResource BandButton}" Command="{Binding AddLineCommand}" />
                    <Button Content="Post voucher" Style="{StaticResource BandButton}" Command="{Binding PostCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Dr" Style="{StaticResource TotalsLabelText}" />
                    <TextBlock Text="{Binding TotalDebit, StringFormat=N2}" Style="{StaticResource TotalsValueText}" />
                    <TextBlock Text="Cr" Style="{StaticResource TotalsLabelText}" />
                    <TextBlock Text="{Binding TotalCredit, StringFormat=N2}" Style="{StaticResource TotalsValueText}" />
                    <TextBlock Text="Difference" Style="{StaticResource TotalsLabelText}" />
                    <TextBlock Text="{Binding Difference, StringFormat=N2}" FontSize="14"
                               Style="{StaticResource TotalsValueText}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource EntryPanelStyle}">
            <StackPanel>
                <TextBlock Text="ALTER AN EXISTING VOUCHER" Style="{StaticResource EntryHeadingText}" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Voucher id" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="300" Style="{StaticResource FieldBox}" Text="{Binding AlterVoucherIdText}" />
                    <Button Content="Load for alter" Style="{StaticResource BandButton}"
                            Command="{Binding LoadForAlterCommand}" />
                    <Button Content="View history" Style="{StaticResource BandButton}"
                            Command="{Binding ViewHistoryCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Reason" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="380" Style="{StaticResource FieldBox}"
                             ToolTip="Required. The reason is written to the edit log with the change."
                             Text="{Binding ChangeReason, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Apply alteration" Style="{StaticResource BandButton}"
                            Command="{Binding ApplyAlterationCommand}" />
                    <Button Content="Cancel voucher" Style="{StaticResource BandButton}"
                            Command="{Binding CancelVoucherCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource PageStatusStyle}">
            <!-- Read-only TextBox rather than a TextBlock: posting errors list every offending line,
                 and the operator needs to scroll and copy them. -->
            <TextBox Text="{Binding Status, Mode=OneWay}" IsReadOnly="True"
                     BorderThickness="0" Background="Transparent"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     FontSize="{StaticResource FontSize.Caption}"
                     TextWrapping="Wrap" MaxHeight="60" VerticalScrollBarVisibility="Auto" />
        </Border>
    </Grid>
</UserControl>
