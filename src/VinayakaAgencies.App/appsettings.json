{
  "Branding": {
    "DisplayName": "Vinayaka Agencies",
    "Tagline": "Motors  ·  Pumps  ·  Spares"
  },
  "Database": {
    "Provider": "Sqlite",
    "DatabaseFileName": "motorpump.db",
    "ApplyMigrationsOnStartup": false
  },
  "Backup": {
    "SecondDestination": "",
    "RetainedBackupCount": 30,
    "ScheduleEnabled": true,
    "ScheduleIntervalHours": 24,
    "BackupOnShutdown": true,
    "VerifyAfterWrite": true
  },
  "Logging": {
    "MinimumLevel": "Information",
    "RetainedFileCountLimit": 31
  }
}
