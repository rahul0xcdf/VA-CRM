<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VinayakaAgencies.Domain\VinayakaAgencies.Domain.csproj" />
    <ProjectReference Include="..\VinayakaAgencies.Application\VinayakaAgencies.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ClosedXML (MIT) for the Phase 8 Excel adapters. Never EPPlus: paid licence since v5
         (CLAUDE.md tech stack, phase-8-interoperability.md §2). -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <!-- DPAPI for the NIC credentials at rest (phase-6-einvoice-eway.md §2). Windows-only by
         design; Phase 9 replaces it when the app stops being single-user on one machine. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The canonical audit encoding (spec §11.3) is hashed into a tamper-evidence chain, so its rules
      — decimal as a 4-dp invariant string, enums by name, ordinal property order — need direct unit
      tests. They cannot be reached through Company, the only entity mapped so far, which has no
      decimal and no enum property.

      This grants the test assembly nothing else it should use: composition still goes through the
      public AddInfrastructure entry point (see SqliteTestHost), and the §11.4 tamper-guard tests
      deliberately reach AppDbContext through the container and the public DbContext surface rather
      than through this attribute, because that guard exists to catch exactly the code that already
      holds the context.
    -->
    <InternalsVisibleTo Include="VinayakaAgencies.Infrastructure.Tests" />
  </ItemGroup>

</Project>
